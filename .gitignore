# Visual Studio / user-specific files
.vs/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
.artifacts/

# Logs
[Ll]og/
[Ll]ogs/
*.log

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# NuGet generated files / packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish output
publish/
*.pubxml
*.publish.xml
*.publishproj
PublishScripts/

# Environment / secrets
.env
.env.*
!.env.example

# SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# SQL Server local database files
*.mdf
*.ldf
*.ndf

# Node packages, if Bootstrap/npm/etc. is used
node_modules/

# Temporary / backup files
*.tmp
~$*
*~
*.bak

# VS Code local history
.history/

# Python cache - harmless to keep if someone uses Python scripts
__pycache__/
*.pyc