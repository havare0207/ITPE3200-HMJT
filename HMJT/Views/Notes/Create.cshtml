@model HMJT.ViewModels.NoteViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Create Note";
}

<!-- Main page heading. -->
<h1>Create New Note</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <!-- Sends the completed note to the Create POST action. -->
        <form asp-controller="Notes"
              asp-action="Create"
              method="post">

            <!-- Protects the POST request against cross-site request forgery. -->
            @Html.AntiForgeryToken()

            <!-- Displays general validation errors.
                 role="alert" and aria-live help assistive technologies
                 announce validation errors when they appear. -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"
                 aria-live="polite">
            </div>


            <!-- =====================================
                 Note title
                 ===================================== -->

            <div class="form-group mb-3">

                <!-- asp-for connects the label to the generated input ID. -->
                <label asp-for="Title"
                       class="form-label">
                </label>

                <!-- Text input for the note title. -->
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter note title" />

                <!-- Displays validation errors related to the title field. -->
                <span asp-validation-for="Title"
                      class="text-danger">
                </span>

            </div>


            <!-- =====================================
                 Note content
                 ===================================== -->

            <div class="form-group mb-3">

                <!-- Label connected to the note content textarea. -->
                <label asp-for="Content"
                       class="form-label">
                </label>

                <!-- Multi-line field for the note content. -->
                <textarea asp-for="Content"
                          class="form-control"
                          rows="6"
                          placeholder="Write your note here...">
                </textarea>

                <!-- Displays validation errors related to note content. -->
                <span asp-validation-for="Content"
                      class="text-danger">
                </span>

            </div>


            <!-- Saves the new note. -->
            <button type="submit"
                    class="btn btn-primary">
                Save Note
            </button>

            <!-- Returns to the note list without saving. -->
            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>


@section Scripts {

    <!-- Enables ASP.NET Core client-side validation. -->
    <partial name="_ValidationScriptsPartial" />

}