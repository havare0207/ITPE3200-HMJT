

@model HMJT.ViewModels.NoteIndexViewModel

@{
    // Sets the title for the page.
    ViewData["Title"] = "Notes";
}

<!-- Welcome heading and introduction. -->
<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <h2 class="mb-0">Notes</h2>
        <span class="badge bg-primary">Notes</span>
    </div>

    <div class="welcome-banner p-4 p-md-5 mb-4 rounded-3 text-white">
        <h2>Welcome to Your Notes! 📝</h2>
        <p class="mb-3">
            Keep track of programming concepts, tricky questions and things
            you want to revise after a game.
        </p>
        <p class="mb-0">
            Create notes, organize your thoughts, and review important
            concepts whenever you need.
            Click <strong>Create New Note</strong> to write a note,
            <strong>Edit</strong> to change it, or
            <strong>Delete</strong> to remove it.
            Happy studying!
        </p>
    </div>
</div>

<!-- Displays error messages if something goes wrong. -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Create note section. -->
<div class="card border-0 shadow-sm p-3 p-md-4 mb-4">
    <div class="mb-3">
        <h5 class="fw-bold mb-1">
            <i class="bi bi-journal-text me-2"></i>
            Organize your notes
        </h5>
        <p class="text-muted small mb-0">
            Save important concepts, write down what you have learned,
            and keep everything in one place.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-1"></i>
            Create New Note
        </a>
    </div>
</div>

<!-- Displays the number of notes. -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Your Notes</h5>
    <span class="badge bg-secondary">
        @Model.Notes.Count() note(s)
    </span>
</div>

<!-- Displays notes supplied by the ViewModel. -->
<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Content</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Notes.Any())
            {
                @foreach (var note in Model.Notes)
                {
                    <tr>
                        <td>@note.Title</td>
                        <td>
                            @(note.Content.Length > 60
                                ? note.Content.Substring(0, 60) + "..."
                                : note.Content)
                        </td>
                        <td>
                            @note.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-action="Edit"
                                   asp-route-id="@note.NoteId"
                                   class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil me-1"></i>
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@note.NoteId"
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash me-1"></i>
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center py-4">
                        <i class="bi bi-journal-text fs-3 d-block mb-2 text-muted"></i>
                        <strong>No notes yet</strong>
                        <p class="text-muted mb-2">
                            Start writing your first note to keep track
                            of what you have learned.
                        </p>
                        <a asp-action="Create"
                           class="btn btn-outline-primary btn-sm">
                            Create your first note
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
