@model HMJT.ViewModels.NoteViewModel

@{
    // Sets the title for the page.
    ViewData["Title"] = "Delete Note";
}

<h2>Delete Note</h2>

<h4>Are you sure you want to delete this note?</h4>

<hr />

<!-- Displays the note information before deletion. -->

<div class="form-group">
    <label asp-for="Title"></label>
    <p class="form-control">@Model.Title</p>
</div>

<div class="form-group">
    <label asp-for="Content"></label>
    <p class="form-control" style="white-space: pre-wrap;">@Model.Content</p>
</div>

<div class="form-group">
    <label asp-for="CreatedAt"></label>
    <p class="form-control">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
</div>

<br />

<!-- Sends the NoteId to the Delete POST action. -->
<form asp-action="Delete" method="post">

    <!-- Keeps the ID of the note being deleted. -->
    <input type="hidden" asp-for="NoteId" />

    <!-- Confirms deletion. -->
    <button type="submit" class="btn btn-danger">Delete</button>

    <!-- Cancels deletion and returns to the note list. -->
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>