@model HMJT.ViewModels.NoteViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Delete Note";
}

<!-- Main page heading. -->
<h1>Delete Note</h1>

<!-- Clear confirmation message before a destructive action. -->
<h2 class="h4">
    Are you sure you want to delete this note?
</h2>

<hr />

<!-- =====================================
     Note information
     ===================================== -->

<!--
    A description list is used because the information below
    is read-only data rather than editable form fields.
-->
<dl class="row">

    <!-- Note title. -->
    <dt class="col-sm-3">
        Title
    </dt>

    <dd class="col-sm-9">
        @Model.Title
    </dd>


    <!-- Note content.
         white-space: pre-wrap preserves the user's line breaks. -->
    <dt class="col-sm-3">
        Content
    </dt>

    <dd class="col-sm-9"
        style="white-space: pre-wrap;">
        @Model.Content
    </dd>


    <!-- Creation date. -->
    <dt class="col-sm-3">
        Created At
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
    </dd>

</dl>


<!-- =====================================
     Delete confirmation
     ===================================== -->

<!-- Sends the NoteId to the Delete POST action. -->
<form asp-action="Delete"
      method="post">

    <!-- Protects the POST request against cross-site request forgery. -->
    @Html.AntiForgeryToken()

    <!-- Keeps the ID of the note being deleted. -->
    <input type="hidden"
           asp-for="NoteId" />

    <!-- Confirms the destructive action. -->
    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <!-- Cancels deletion and returns to the note list. -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>