@model HMJT.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Delete Note";
}

<h1>Delete Note</h1>

<h3>Are you sure you want to delete this note?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Content</dt>
    <dd class="col-sm-10" style="white-space: pre-wrap;">@Model.Content</dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-controller="Notes"
      asp-action="Delete"
      asp-route-id="@Model.NoteId"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>