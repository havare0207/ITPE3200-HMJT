@{
    // Sets the browser/page title.
    ViewData["Title"] = "Home";
}

<!-- =====================================
     Home hero
     ===================================== -->

<section class="home-hero"
         aria-labelledby="home-main-heading">

    <div class="home-hero-content">

        <!-- Small introductory label.
             This is ordinary text rather than a heading because
             it does not represent a new document section. -->
        <p class="home-eyebrow">
            CODING • TRIVIA • STRATEGY
        </p>

        <!-- Main heading for the page. -->
        <h1 id="home-main-heading">
            Learn. Compete.
            <span>Conquer the Code.</span>
        </h1>

        <p class="home-hero-text">
            Code Pursuit is a local multiplayer trivia game where
            2–6 players move around the board, answer programming
            questions and collect all six category wedges.
        </p>

        <!-- Primary navigation actions for the home page. -->
        <div class="home-hero-actions">

            <a asp-controller="Gameplay"
               asp-action="Play"
               class="home-primary-button">
                Start a Game
            </a>

            <!-- Links directly to the How to Play heading below. -->
            <a href="#how-to-play-heading"
               class="home-secondary-button">
                How to Play
            </a>

        </div>


        <!--
            Quick game statistics.

            The information is provided as text instead of being
            represented only through graphics or colors.
        -->
        <div class="home-hero-stats"
             aria-label="Game overview">

            <div>
                <strong>2–6</strong>
                <span>Players</span>
            </div>

            <div>
                <strong>6</strong>
                <span>Categories</span>
            </div>

            <div>
                <strong>3</strong>
                <span>Difficulties</span>
            </div>

        </div>

    </div>


    <!-- =====================================
         Category artwork
         ===================================== -->

    <div class="home-hero-visual">

        <div class="home-category-image-card">

            <!--
                This image contains useful category information,
                so it receives descriptive alternative text.

                A screen-reader user therefore receives the same
                basic information represented visually in the image.
            -->
            <img src="~/images/home/categories.png"
                 alt="Illustration showing the six Code Pursuit categories: Java, JavaScript, HTML and CSS, Python, Game History and C sharp."
                 class="home-category-image" />

        </div>

    </div>

</section>


<!-- =====================================
     Category overview
     ===================================== -->

<section class="home-section"
         aria-labelledby="category-overview-heading">

    <div class="home-section-heading">

        <p class="home-eyebrow">
            SIX CATEGORIES
        </p>

        <h2 id="category-overview-heading">
            Collect every wedge
        </h2>

        <p>
            Answer questions from all six categories to complete
            your player piece and unlock your chance to win.
        </p>

    </div>


    <div class="home-category-grid">

        <!-- Java category. -->
        <article class="home-category-card category-java">

            <div class="home-category-symbol"
                 aria-hidden="true">
                ☕
            </div>

            <h3>Java</h3>

            <p>
                Syntax, classes, objects and core Java concepts.
            </p>

        </article>


        <!-- JavaScript category. -->
        <article class="home-category-card category-javascript">

            <div class="home-category-symbol"
                 aria-hidden="true">
                ⚡
            </div>

            <h3>JavaScript</h3>

            <p>
                Web programming, logic, functions and scripting.
            </p>

        </article>


        <!-- HTML/CSS category. -->
        <article class="home-category-card category-html">

            <div class="home-category-symbol"
                 aria-hidden="true">
                🌐
            </div>

            <h3>HTML/CSS</h3>

            <p>
                Web structure, styling and frontend fundamentals.
            </p>

        </article>


        <!-- Python category. -->
        <article class="home-category-card category-python">

            <div class="home-category-symbol"
                 aria-hidden="true">
                🐍
            </div>

            <h3>Python</h3>

            <p>
                Python syntax, data structures and programming logic.
            </p>

        </article>


        <!-- Game History category. -->
        <article class="home-category-card category-history">

            <div class="home-category-symbol"
                 aria-hidden="true">
                🎮
            </div>

            <h3>Game History</h3>

            <p>
                Games, developers, consoles and gaming history.
            </p>

        </article>


        <!-- C# category. -->
        <article class="home-category-card category-csharp">

            <div class="home-category-symbol"
                 aria-hidden="true">
                #️⃣
            </div>

            <h3>C#</h3>

            <p>
                C# syntax, .NET concepts and object-oriented programming.
            </p>

        </article>

    </div>

</section>


<!-- =====================================
     How to play
     ===================================== -->

<section id="how-to-play"
         class="home-section home-rules-section"
         aria-labelledby="how-to-play-heading">

    <div class="home-section-heading">

        <p class="home-eyebrow">
            HOW TO PLAY
        </p>

        <!--
            tabindex="-1" allows this heading to receive focus
            when users navigate directly to it from the link above.
        -->
        <h2 id="how-to-play-heading"
            tabindex="-1">
            Simple rules. Six wedges. One winner.
        </h2>

        <p>
            Code Pursuit is played in six main steps.
            Read the steps below in order to learn how to play.
        </p>

    </div>


    <!--
        The rules form an ordered list.

        This lets screen readers announce that the user has entered
        a list containing six steps and makes the rule sequence
        easier to understand without relying on the visual numbers.
    -->
    <ol class="home-rule-grid list-unstyled">

        <!-- Step 1. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                1
            </span>

            <h3>
                <span class="visually-hidden">Step 1: </span>
                Set up the game
            </h3>

            <p>
                Enter names for 2–6 local players and choose
                Easy, Medium or Hard question difficulty.
            </p>

        </li>


        <!-- Step 2. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                2
            </span>

            <h3>
                <span class="visually-hidden">Step 2: </span>
                Choose who starts
            </h3>

            <p>
                Code Pursuit randomly selects the first player.
                Players then take turns in order.
            </p>

        </li>


        <!-- Step 3. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                3
            </span>

            <h3>
                <span class="visually-hidden">Step 3: </span>
                Roll and move
            </h3>

            <p>
                Roll the die and move the exact number of spaces.
                A six lets you choose any available destination.
            </p>

        </li>


        <!-- Step 4. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                4
            </span>

            <h3>
                <span class="visually-hidden">Step 4: </span>
                Answer a question
            </h3>

            <p>
                The colored field you land on determines the
                question category. The category is also identified
                by text on the game board.
                Answer correctly to collect its wedge if you do
                not already own it.
            </p>

        </li>


        <!-- Step 5. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                5
            </span>

            <h3>
                <span class="visually-hidden">Step 5: </span>
                Use special spaces
            </h3>

            <p>
                Landing on Roll Again gives you another roll.
                Reaching the center during a normal round lets
                you choose your question category.
            </p>

        </li>


        <!-- Step 6. -->
        <li class="home-rule-card">

            <span class="home-rule-number"
                  aria-hidden="true">
                6
            </span>

            <h3>
                <span class="visually-hidden">Step 6: </span>
                Win the game
            </h3>

            <p>
                Collect all six wedges and return to the center.
                The other players choose your final category.
                Answer correctly to win Code Pursuit.
            </p>

        </li>

    </ol>

</section>


<!-- =====================================
     Final call to action
     ===================================== -->

<section class="home-play-banner"
         aria-labelledby="home-play-heading">

    <div>

        <p class="home-eyebrow home-eyebrow-light">
            READY TO PLAY?
        </p>

        <h2 id="home-play-heading">
            Begin your Code Pursuit
        </h2>

        <p>
            Gather your players, choose a difficulty and see
            who can collect all six wedges first.
        </p>

    </div>


    <a asp-controller="Gameplay"
       asp-action="Play"
       class="home-banner-button">
        Start Game
    </a>

</section>