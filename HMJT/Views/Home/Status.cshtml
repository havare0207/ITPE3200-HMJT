@{
    var code =
        ViewData["Code"] as int? ?? 0;

    ViewData["Title"] =
        code == 404
            ? "Page not found"
            : code == 403
                ? "Access denied"
                : "Something went wrong";
}

<div class="card p-4 p-md-5 text-center">

    @if (code == 404)
    {
        <h1 class="display-4">
            404
        </h1>

        <h2 class="h4 mb-3">
            Page could not be found
        </h2>

        <p>
            The requested page could not be found.
            Please check the address or try again later.
        </p>
    }
    else if (code == 403)
    {
        <h1 class="display-4">
            403
        </h1>

        <h2 class="h4 mb-3">
            Access denied
        </h2>

        <p>
            You do not have permission to access
            this resource.
        </p>
    }
    else
    {
        <h1 class="display-4">
            @code
        </h1>

        <h2 class="h4 mb-3">
            Something went wrong
        </h2>

        <p>
            The request could not be completed.
            Please try again later.
        </p>
    }

    <div class="d-flex justify-content-center">

        <a class="btn btn-primary"
           asp-controller="Home"
           asp-action="Index">
            Back to home
        </a>

    </div>

</div>