@{
    var code = ViewData["Code"] as int? ?? 0;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}

<div class="card p-4 p-md-5 text-center">
    @if (code == 404)
    {
        <h1 class="display-4">404</h1>
        <h2 class="h4 mb-3">We could not find that page</h2>
        <p>The page or item you are looking for does not exist. It may have been deleted or moved.</p>
    }
    else
    {
        <h1 class="display-4">@code</h1>
        <h2 class="h4 mb-3">Something went wrong</h2>
        <p>The request could not be completed. Please try again.</p>
    }

    <div class="d-flex justify-content-center gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        <a class="btn btn-outline-secondary" asp-controller="Question" asp-action="Index">Questions</a>
    </div>
</div>
