@{
    // Sets the browser/page title shown in the tab.
    ViewData["Title"] = "Categories";
}

<!--
    Main Categories page.

    aria-labelledby connects the entire section to the main h1 heading,
    which gives assistive technologies a clear description of the page.
-->
<section class="categories-page"
         aria-labelledby="categories-main-heading">

    <!-- =====================================
         Page heading
         ===================================== -->

    <div class="categories-heading">

        <!-- Small visual introductory label.
             This is normal text rather than a heading because
             it does not introduce a separate section. -->
        <p class="categories-eyebrow">
            LEARN BEFORE YOU PLAY
        </p>

        <!-- Main heading for the page.
             Every page should have one clear primary h1 heading. -->
        <h1 id="categories-main-heading">
            Code Pursuit Categories
        </h1>

        <!-- Short introduction explaining the purpose of the page. -->
        <p>
            Explore the six categories used in Code Pursuit.
            Use the resources below to practise programming concepts
            or learn more about the history of video games.
        </p>

    </div>


    <!-- =====================================
         Category cards
         =====================================

         Each category is represented by an <article>.
         This gives the cards meaningful semantic structure instead
         of using only generic <div> elements.
         ===================================== -->

    <div class="categories-resource-grid">


        <!-- =====================================
             Java
             ===================================== -->

        <article class="resource-card resource-java"
                 aria-labelledby="java-resource-heading">

            <!--
                Decorative category icon.

                The category name "Java" is already written as text,
                so the emoji does not provide additional information.
                aria-hidden prevents screen readers from unnecessarily
                announcing the decorative symbol.
            -->
            <div class="resource-icon"
                 aria-hidden="true">
                ☕
            </div>

            <div>

                <!-- Visual category label. -->
                <p class="resource-category-label">
                    JAVA
                </p>

                <!-- Heading for this category card. -->
                <h2 id="java-resource-heading">Java</h2>

                <p>
                    Learn Java syntax, classes, objects,
                    methods and object-oriented programming.
                </p>

            </div>

            <!-- Links to learning resources for Java. -->
            <div class="resource-button-group"
                 role="group"
                 aria-label="Java learning resources">

                <!--
                    External link opens in a new browser tab.

                    target="_blank" opens the new tab.
                    rel="noopener noreferrer" prevents the external
                    website from getting unnecessary access to this page.

                    aria-label explicitly tells screen-reader users
                    that the link opens in a new tab.
                -->
                <a href="https://www.w3schools.com/java/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open Java tutorials on W3Schools in a new tab">

                    W3Schools ↗

                </a>

                <!-- Official Java website. -->
                <a href="https://www.oracle.com/java/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the official Java website in a new tab">

                    Official Java ↗

                </a>

            </div>

        </article>


        <!-- =====================================
             JavaScript
             ===================================== -->

        <article class="resource-card resource-javascript"
                 aria-labelledby="javascript-resource-heading">

            <!-- Decorative icon.
                 JavaScript is already identified by visible text. -->
            <div class="resource-icon"
                 aria-hidden="true">
                ⚡
            </div>

            <div>

                <p class="resource-category-label">
                    JAVASCRIPT
                </p>

                <h2 id="javascript-resource-heading">JavaScript</h2>

                <p>
                    Practise variables, functions, objects,
                    conditions and browser scripting.
                </p>

            </div>

            <div class="resource-button-group"
                 role="group"
                 aria-label="JavaScript learning resources">

                <!-- W3Schools JavaScript resource. -->
                <a href="https://www.w3schools.com/js/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open JavaScript tutorials on W3Schools in a new tab">

                    W3Schools ↗

                </a>

                <!-- Official ECMAScript specification. -->
                <a href="https://tc39.es/ecma262/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the ECMAScript standard in a new tab">

                    ECMAScript Standard ↗

                </a>

            </div>

        </article>


        <!-- =====================================
             HTML / CSS
             ===================================== -->

        <article class="resource-card resource-html"
                 aria-labelledby="html-css-resource-heading">

            <!-- Decorative web icon. -->
            <div class="resource-icon"
                 aria-hidden="true">
                🌐
            </div>

            <div>

                <p class="resource-category-label">
                    HTML / CSS
                </p>

                <h2 id="html-css-resource-heading">HTML/CSS</h2>

                <p>
                    Learn how web pages are structured with HTML
                    and styled using CSS.
                </p>

            </div>

            <!--
                This category contains more links than the other cards,
                so the existing wrap class allows the buttons to move
                onto additional lines when space is limited.
            -->
            <div class="resource-button-group resource-button-group-wrap"
                 role="group"
                 aria-label="HTML and CSS learning resources">

                <!-- HTML tutorial. -->
                <a href="https://www.w3schools.com/html/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open HTML tutorials on W3Schools in a new tab">

                    HTML W3Schools ↗

                </a>

                <!-- CSS tutorial. -->
                <a href="https://www.w3schools.com/css/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open CSS tutorials on W3Schools in a new tab">

                    CSS W3Schools ↗

                </a>

                <!-- HTML standard. -->
                <a href="https://html.spec.whatwg.org/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the HTML standard in a new tab">

                    HTML Standard ↗

                </a>

                <!-- CSS standards documentation. -->
                <a href="https://www.w3.org/TR/css/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the CSS standards documentation in a new tab">

                    CSS Standard ↗

                </a>

            </div>

        </article>


        <!-- =====================================
             Python
             ===================================== -->

        <article class="resource-card resource-python"
                 aria-labelledby="python-resource-heading">

            <!-- Decorative Python icon. -->
            <div class="resource-icon"
                 aria-hidden="true">
                🐍
            </div>

            <div>

                <p class="resource-category-label">
                    PYTHON
                </p>

                <h2 id="python-resource-heading">Python</h2>

                <p>
                    Explore Python syntax, loops, functions,
                    collections and programming fundamentals.
                </p>

            </div>

            <div class="resource-button-group"
                 role="group"
                 aria-label="Python learning resources">

                <!-- Python tutorial. -->
                <a href="https://www.w3schools.com/python/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open Python tutorials on W3Schools in a new tab">

                    W3Schools ↗

                </a>

                <!-- Official Python website. -->
                <a href="https://www.python.org/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the official Python website in a new tab">

                    Python.org ↗

                </a>

            </div>

        </article>


        <!-- =====================================
             Game History
             ===================================== -->

        <article class="resource-card resource-history"
                 aria-labelledby="game-history-resource-heading">

            <!-- Decorative game controller icon. -->
            <div class="resource-icon"
                 aria-hidden="true">
                🎮
            </div>

            <div>

                <p class="resource-category-label">
                    GAME HISTORY
                </p>

                <h2 id="game-history-resource-heading">Game History</h2>

                <p>
                    Explore some important milestones in the
                    development of video games and consoles.
                </p>

            </div>

            <div class="resource-button-group"
                 role="group"
                 aria-label="Game History learning resources">

                <!--
                    Internal page link.

                    Unlike the external links, this keeps the user
                    on the current page and scrolls directly to
                    the timeline section below.
                -->
                <a href="#game-history-heading"
                   class="resource-button"
                   aria-label="Jump to the short Game History timeline">

                    Short Timeline ↓

                </a>

                <!-- External full timeline resource. -->
                <a href="https://www.museumofplay.org/video-game-history-timeline/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open the full game history timeline in a new tab">

                    Full Game History Timeline ↗

                </a>

            </div>

        </article>


        <!-- =====================================
             C#
             ===================================== -->

        <article class="resource-card resource-csharp"
                 aria-labelledby="csharp-resource-heading">

            <!-- Decorative C# symbol. -->
            <div class="resource-icon"
                 aria-hidden="true">
                #️⃣
            </div>

            <div>

                <p class="resource-category-label">
                    C#
                </p>

                <h2 id="csharp-resource-heading">C#</h2>

                <p>
                    Learn C# syntax, classes, methods,
                    collections and .NET fundamentals.
                </p>

            </div>

            <div class="resource-button-group"
                 role="group"
                 aria-label="C sharp learning resources">

                <!-- C# tutorial. -->
                <a href="https://www.w3schools.com/cs/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button"
                   aria-label="Open C sharp tutorials on W3Schools in a new tab">

                    W3Schools ↗

                </a>

                <!-- Official Microsoft C# documentation. -->
                <a href="https://learn.microsoft.com/en-us/dotnet/csharp/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="resource-button resource-button-secondary"
                   aria-label="Open Microsoft C sharp documentation in a new tab">

                    Microsoft C# Docs ↗

                </a>

            </div>

        </article>

    </div>


    <!-- =====================================
         Game history timeline
         ===================================== -->

    <!--
        Internal target used by the "Short Timeline" link above.

        aria-labelledby connects this section to its h2,
        giving the section a meaningful accessible name.
    -->
    <section id="game-history-timeline"
             class="game-history-section"
             aria-labelledby="game-history-heading">

        <div class="categories-section-heading">

            <p class="categories-eyebrow">
                GAME HISTORY
            </p>

            <h2 id="game-history-heading"
                tabindex="-1">
                A Short Timeline of Video Games
            </h2>

            <p>
                Some important moments from early computer games
                to the modern gaming industry.
            </p>

        </div>


        <ol class="game-history-timeline list-unstyled"
            aria-label="Chronological Game History timeline">


            <!-- =====================================
                 1958
                 ===================================== -->

            <li class="timeline-item">

                <!--
                    aria-label makes the meaning of the number explicit
                    instead of leaving a screen reader to interpret "1958"
                    without additional context.
                -->
                <div class="timeline-year"
                     aria-label="Year 1958">
                    1958
                </div>

                <div class="timeline-content">

                    <h3>Tennis for Two</h3>

                    <p>
                        One of the earliest interactive electronic
                        games is demonstrated using an oscilloscope.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 1962
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 1962">
                    1962
                </div>

                <div class="timeline-content">

                    <h3>Spacewar!</h3>

                    <p>
                        Spacewar! becomes one of the earliest
                        influential computer games.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 1972
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 1972">
                    1972
                </div>

                <div class="timeline-content">

                    <h3>Pong</h3>

                    <p>
                        Atari releases Pong, helping arcade
                        video games reach a much wider audience.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 1985
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 1985">
                    1985
                </div>

                <div class="timeline-content">

                    <h3>Nintendo Entertainment System</h3>

                    <p>
                        The NES launches in North America and
                        helps revitalise the home console market.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 1993
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 1993">
                    1993
                </div>

                <div class="timeline-content">

                    <h3>Doom</h3>

                    <p>
                        Doom becomes a landmark title for
                        first-person shooters and PC gaming.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 1994
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 1994">
                    1994
                </div>

                <div class="timeline-content">

                    <h3>PlayStation</h3>

                    <p>
                        Sony launches the original PlayStation
                        in Japan.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 2004
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 2004">
                    2004
                </div>

                <div class="timeline-content">

                    <h3>World of Warcraft</h3>

                    <p>
                        Online multiplayer gaming grows further
                        with the release of World of Warcraft.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 2011
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Year 2011">
                    2011
                </div>

                <div class="timeline-content">

                    <h3>Minecraft</h3>

                    <p>
                        Minecraft receives its full release and
                        becomes one of the most successful games ever made.
                    </p>

                </div>

            </li>


            <!-- =====================================
                 Present day
                 ===================================== -->

            <li class="timeline-item">

                <div class="timeline-year"
                     aria-label="Present day">
                    Today
                </div>

                <div class="timeline-content">

                    <h3>Modern Gaming</h3>

                    <p>
                        Gaming now spans PCs, consoles, mobile devices,
                        virtual reality, cloud services and competitive esports.
                    </p>

                </div>

            </li>

        </ol>

    </section>


    <!-- =====================================
         W3Schools information
         ===================================== -->

    <!--
        Separate learning-resource section.

        aria-labelledby connects the section to the W3Schools heading,
        giving screen-reader users clear page structure.
    -->
    <section class="w3schools-resource-card"
             aria-labelledby="w3schools-resource-heading">

        <div>

            <p class="categories-eyebrow">
                EXTERNAL LEARNING RESOURCE
            </p>

            <h2 id="w3schools-resource-heading">
                W3Schools
            </h2>

            <p>
                W3Schools provides tutorials, examples and interactive
                exercises for many of the programming languages used
                in Code Pursuit.
            </p>

        </div>


        <!--
            External W3Schools link.

            The visible arrow gives sighted users an indication that
            the link leaves the current page, while aria-label explicitly
            explains the new-tab behaviour to screen-reader users.
        -->
        <a href="https://www.w3schools.com/"
           target="_blank"
           rel="noopener noreferrer"
           class="w3schools-button"
           aria-label="Visit W3Schools in a new tab">

            Visit W3Schools ↗

        </a>

    </section>

</section>