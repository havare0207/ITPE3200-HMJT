@{
    ViewData["Title"] = "Categories";
}

<section class="categories-page">

    <!-- =====================================
         Page heading
         ===================================== -->

    <div class="categories-heading">

        <p class="categories-eyebrow">
            LEARN BEFORE YOU PLAY
        </p>

        <h1>
            Code Pursuit Categories
        </h1>

        <p>
            Explore the six categories used in Code Pursuit.
            Use the resources below to practise programming concepts
            or learn more about the history of video games.
        </p>

    </div>


    <!-- =====================================
         Category cards
         ===================================== -->

    <div class="categories-resource-grid">


        <!-- Java -->
        <article class="resource-card resource-java">

            <div class="resource-icon">
                ☕
            </div>

            <div>
                <p class="resource-category-label">
                    JAVA
                </p>

                <h2>Java</h2>

                <p>
                    Learn Java syntax, classes, objects,
                    methods and object-oriented programming.
                </p>
            </div>

            <div class="resource-button-group">

                <a href="https://www.w3schools.com/java/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    W3Schools ↗

                </a>

                <a href="https://www.oracle.com/java/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    Official Java ↗

                </a>

            </div>

        </article>


        <!-- JavaScript -->
        <article class="resource-card resource-javascript">

            <div class="resource-icon">
                ⚡
            </div>

            <div>
                <p class="resource-category-label">
                    JAVASCRIPT
                </p>

                <h2>JavaScript</h2>

                <p>
                    Practise variables, functions, objects,
                    conditions and browser scripting.
                </p>
            </div>

            <div class="resource-button-group">

                <a href="https://www.w3schools.com/js/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    W3Schools ↗

                </a>

                <a href="https://tc39.es/ecma262/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    ECMAScript Standard ↗

                </a>

            </div>

        </article>


        <!-- HTML / CSS -->
        <article class="resource-card resource-html">

            <div class="resource-icon">
                🌐
            </div>

            <div>
                <p class="resource-category-label">
                    HTML / CSS
                </p>

                <h2>HTML/CSS</h2>

                <p>
                    Learn how web pages are structured with HTML
                    and styled using CSS.
                </p>
            </div>

            <div class="resource-button-group resource-button-group-wrap">

                <a href="https://www.w3schools.com/html/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    HTML W3Schools ↗

                </a>

                <a href="https://www.w3schools.com/css/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    CSS W3Schools ↗

                </a>

                <a href="https://html.spec.whatwg.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    HTML Standard ↗

                </a>

                <a href="https://www.w3.org/TR/css/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    CSS Standard ↗

                </a>

            </div>

        </article>


        <!-- Python -->
        <article class="resource-card resource-python">

            <div class="resource-icon">
                🐍
            </div>

            <div>
                <p class="resource-category-label">
                    PYTHON
                </p>

                <h2>Python</h2>

                <p>
                    Explore Python syntax, loops, functions,
                    collections and programming fundamentals.
                </p>
            </div>

            <div class="resource-button-group">

                <a href="https://www.w3schools.com/python/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    W3Schools ↗

                </a>

                <a href="https://www.python.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    Python.org ↗

                </a>

            </div>

        </article>


        <!-- Game History -->
        <article class="resource-card resource-history">

            <div class="resource-icon">
                🎮
            </div>

            <div>
                <p class="resource-category-label">
                    GAME HISTORY
                </p>

                <h2>Game History</h2>

                <p>
                    Explore some important milestones in the
                    development of video games and consoles.
                </p>
            </div>

            <div class="resource-button-group">

                <a href="#game-history-timeline"
                class="resource-button">

                    Short Timeline ↓

                </a>

                <a href="https://www.museumofplay.org/video-game-history-timeline/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    Full Game History Timeline ↗

                </a>

            </div>

        </article>


        <!-- C# -->
        <article class="resource-card resource-csharp">

            <div class="resource-icon">
                #️⃣
            </div>

            <div>
                <p class="resource-category-label">
                    C#
                </p>

                <h2>C#</h2>

                <p>
                    Learn C# syntax, classes, methods,
                    collections and .NET fundamentals.
                </p>
            </div>

            <div class="resource-button-group">

                <a href="https://www.w3schools.com/cs/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button">

                    W3Schools ↗

                </a>

                <a href="https://learn.microsoft.com/en-us/dotnet/csharp/"
                target="_blank"
                rel="noopener noreferrer"
                class="resource-button resource-button-secondary">

                    Microsoft C# Docs ↗

                </a>

            </div>

        </article>

    </div>


    <!-- =====================================
         Game history timeline
         ===================================== -->

    <section id="game-history-timeline"
             class="game-history-section">

        <div class="categories-section-heading">

            <p class="categories-eyebrow">
                GAME HISTORY
            </p>

            <h2>
                A Short Timeline of Video Games
            </h2>

            <p>
                Some important moments from early computer games
                to the modern gaming industry.
            </p>

        </div>


        <div class="game-history-timeline">


            <article class="timeline-item">

                <div class="timeline-year">
                    1958
                </div>

                <div class="timeline-content">

                    <h3>Tennis for Two</h3>

                    <p>
                        One of the earliest interactive electronic
                        games is demonstrated using an oscilloscope.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    1962
                </div>

                <div class="timeline-content">

                    <h3>Spacewar!</h3>

                    <p>
                        Spacewar! becomes one of the earliest
                        influential computer games.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    1972
                </div>

                <div class="timeline-content">

                    <h3>Pong</h3>

                    <p>
                        Atari releases Pong, helping arcade
                        video games reach a much wider audience.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    1985
                </div>

                <div class="timeline-content">

                    <h3>Nintendo Entertainment System</h3>

                    <p>
                        The NES launches in North America and
                        helps revitalise the home console market.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    1993
                </div>

                <div class="timeline-content">

                    <h3>Doom</h3>

                    <p>
                        Doom becomes a landmark title for
                        first-person shooters and PC gaming.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    1994
                </div>

                <div class="timeline-content">

                    <h3>PlayStation</h3>

                    <p>
                        Sony launches the original PlayStation
                        in Japan.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    2004
                </div>

                <div class="timeline-content">

                    <h3>World of Warcraft</h3>

                    <p>
                        Online multiplayer gaming grows further
                        with the release of World of Warcraft.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    2011
                </div>

                <div class="timeline-content">

                    <h3>Minecraft</h3>

                    <p>
                        Minecraft receives its full release and
                        becomes one of the most successful games ever made.
                    </p>

                </div>

            </article>


            <article class="timeline-item">

                <div class="timeline-year">
                    Today
                </div>

                <div class="timeline-content">

                    <h3>Modern Gaming</h3>

                    <p>
                        Gaming now spans PCs, consoles, mobile devices,
                        virtual reality, cloud services and competitive esports.
                    </p>

                </div>

            </article>

        </div>

    </section>


    <!-- =====================================
         W3Schools information
         ===================================== -->

    <section class="w3schools-resource-card">

        <div>

            <p class="categories-eyebrow">
                EXTERNAL LEARNING RESOURCE
            </p>

            <h2>
                W3Schools
            </h2>

            <p>
                W3Schools provides tutorials, examples and interactive
                exercises for many of the programming languages used
                in Code Pursuit.
            </p>

        </div>


        <a href="https://www.w3schools.com/"
           target="_blank"
           rel="noopener noreferrer"
           class="w3schools-button">

            Visit W3Schools ↗

        </a>

    </section>

</section>