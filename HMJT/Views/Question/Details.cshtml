@model HMJT.ViewModels.QuestionViewModel

@{
    // Sets the title for the page.
    ViewData["Title"] = "Question Details";
}

<h2>Question Details</h2>

<!-- Displays the question information supplied by QuestionViewModel. -->

<div class="form-group">
    <label asp-for="QuestionText"></label>
    <p class="form-control">@Model.QuestionText</p>
</div>

<div class="form-group">
    <label asp-for="Category"></label>
    <p class="form-control">@Model.Category</p>
</div>

<div class="form-group">
    <label asp-for="Difficulty"></label>
    <p class="form-control">@Model.Difficulty</p>
</div>

<div class="form-group">
    <label asp-for="AnswerA"></label>
    <p class="form-control">@Model.AnswerA</p>
</div>

<div class="form-group">
    <label asp-for="AnswerB"></label>
    <p class="form-control">@Model.AnswerB</p>
</div>

<div class="form-group">
    <label asp-for="AnswerC"></label>
    <p class="form-control">@Model.AnswerC</p>
</div>

<div class="form-group">
    <label asp-for="AnswerD"></label>
    <p class="form-control">@Model.AnswerD</p>
</div>

<div class="form-group">
    <label asp-for="CorrectAnswer"></label>
    <p class="form-control">@Model.CorrectAnswer</p>
</div>

<div class="form-group">
    <label>Game</label>
    <p class="form-control">@Model.GameName</p>
</div>

<br />

<!-- Opens the Edit page for this question. -->
<a asp-action="Edit"
   asp-route-id="@Model.QuestionId"
   class="btn btn-warning">
    Edit
</a>

<!-- Returns to the list of questions. -->
<a asp-action="Index" class="btn btn-secondary">Back to Questions</a>