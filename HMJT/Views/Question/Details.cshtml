@model HMJT.ViewModels.QuestionViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Question Details";
}

<!-- Main page heading. -->
<h1>Question Details</h1>

<!-- =====================================
     Question information
     ===================================== -->

<!--
    A description list represents the read-only question data.
    Each <dt> describes the corresponding <dd> value.
-->
<dl class="row">

    <!-- Question text. -->
    <dt class="col-sm-3">
        Question
    </dt>

    <dd class="col-sm-9">
        @Model.QuestionText
    </dd>


    <!-- Category. -->
    <dt class="col-sm-3">
        Category
    </dt>

    <dd class="col-sm-9">
        @Model.Category
    </dd>


    <!-- Difficulty. -->
    <dt class="col-sm-3">
        Difficulty
    </dt>

    <dd class="col-sm-9">
        @Model.Difficulty
    </dd>


    <!-- Answer A. -->
    <dt class="col-sm-3">
        Answer A
    </dt>

    <dd class="col-sm-9">
        @Model.AnswerA
    </dd>


    <!-- Answer B. -->
    <dt class="col-sm-3">
        Answer B
    </dt>

    <dd class="col-sm-9">
        @Model.AnswerB
    </dd>


    <!-- Answer C. -->
    <dt class="col-sm-3">
        Answer C
    </dt>

    <dd class="col-sm-9">
        @Model.AnswerC
    </dd>


    <!-- Answer D. -->
    <dt class="col-sm-3">
        Answer D
    </dt>

    <dd class="col-sm-9">
        @Model.AnswerD
    </dd>


    <!-- Correct answer. -->
    <dt class="col-sm-3">
        Correct Answer
    </dt>

    <dd class="col-sm-9">
        @Model.CorrectAnswer
    </dd>


    <!-- Game that owns this question. -->
    <dt class="col-sm-3">
        Game
    </dt>

    <dd class="col-sm-9">
        @Model.GameName
    </dd>

</dl>


<!-- =====================================
     Page actions
     ===================================== -->

<div class="d-flex flex-wrap gap-2">

    <!-- Opens the Edit page for this question. -->
    <a asp-action="Edit"
       asp-route-id="@Model.QuestionId"
       class="btn btn-warning"
       aria-label="Edit question: @Model.QuestionText">
        Edit
    </a>

    <!-- Returns to the main question list. -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Questions
    </a>

</div>