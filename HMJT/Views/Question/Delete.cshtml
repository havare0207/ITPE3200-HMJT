@model HMJT.ViewModels.QuestionViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Delete Question";
}

<!-- Main page heading. -->
<h1>Delete Question</h1>

<!-- Clear warning before the destructive action. -->
<h2 class="h4">
    Are you sure you want to delete this question?
</h2>

<hr />

<!-- =====================================
     Question information
     ===================================== -->

<!--
    A description list is used because this information is read-only.
    This is more semantically correct than displaying ordinary text
    inside elements styled as form controls.
-->
<dl class="row">

    <!-- Question text. -->
    <dt class="col-sm-3">
        Question
    </dt>

    <dd class="col-sm-9">
        @Model.QuestionText
    </dd>


    <!-- Question category. -->
    <dt class="col-sm-3">
        Category
    </dt>

    <dd class="col-sm-9">
        @Model.Category
    </dd>


    <!-- Question difficulty. -->
    <dt class="col-sm-3">
        Difficulty
    </dt>

    <dd class="col-sm-9">
        @Model.Difficulty
    </dd>


    <!-- Correct answer option. -->
    <dt class="col-sm-3">
        Correct Answer
    </dt>

    <dd class="col-sm-9">
        @Model.CorrectAnswer
    </dd>

</dl>


<!-- =====================================
     Delete confirmation
     ===================================== -->

<!-- Sends the QuestionId to the Delete POST action. -->
<form asp-action="Delete"
      method="post">

    <!-- Protects the POST request against cross-site request forgery. -->
    @Html.AntiForgeryToken()

    <!-- Keeps the ID of the question being deleted. -->
    <input type="hidden"
           asp-for="QuestionId" />

    <!-- Keeps the associated GameId.
         Ownership must still be verified server-side. -->
    <input type="hidden"
           asp-for="GameId" />

    <!-- Confirms the destructive action. -->
    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <!-- Cancels deletion and returns to the question list. -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>