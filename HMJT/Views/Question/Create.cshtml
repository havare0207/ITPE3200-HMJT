@model HMJT.ViewModels.QuestionViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Create Question";
}

<!-- Main page heading. -->
<h1>Create New Question</h1>

<!-- Explains the required-field marker for all users.
     The asterisk itself is hidden from screen readers because
     the meaning is provided as text. -->
<p class="text-muted">
    Fields marked with
    <span class="text-danger" aria-hidden="true">*</span>
    <span class="visually-hidden">an asterisk</span>
    are required.
</p>

<!-- Sends the completed question to the Create POST action. -->
<form asp-action="Create"
      method="post">

    <!-- Protects the POST request against cross-site request forgery. -->
    @Html.AntiForgeryToken()

    <!-- Stores the GameId so the new question is connected
         to the correct custom game. -->
    <input type="hidden"
           asp-for="GameId" />

    <!-- Displays validation errors that are not connected
         to one specific form field.
         role="alert" helps assistive technologies announce errors. -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert"
         aria-live="polite">
    </div>


    <!-- =====================================
         Question text
         ===================================== -->

    <div class="form-group">

        <!-- asp-for connects the label to the generated input ID. -->
        <label asp-for="QuestionText"
               class="form-label">
        </label>

        <!-- Visible required-field marker. -->
        <span class="text-danger"
              aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>

        <!-- Text field containing the question itself. -->
        <input asp-for="QuestionText"
               class="form-control"
               aria-required="true" />

        <!-- Displays validation errors for the question text. -->
        <span asp-validation-for="QuestionText"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================
         Category
         ===================================== -->

    <div class="form-group mt-3">

        <label asp-for="Category"
               class="form-label">
        </label>

        <span class="text-danger"
              aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>

        <!-- Category options are supplied by QuestionViewModel. -->
        <select asp-for="Category"
                asp-items="Model.Categories"
                class="form-select"
                aria-required="true">

            <option value="">
                -- Select a category --
            </option>

        </select>

        <span asp-validation-for="Category"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================
         Difficulty
         ===================================== -->

    <div class="form-group mt-3">

        <label asp-for="Difficulty"
               class="form-label">
        </label>

        <span class="text-danger"
              aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>

        <!-- Difficulty options are supplied by the ViewModel. -->
        <select asp-for="Difficulty"
                asp-items="Model.Difficulties"
                class="form-select"
                aria-required="true">
        </select>

        <span asp-validation-for="Difficulty"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================
         Answer options
         ===================================== -->

    <!--
        The four answers form one logical group, so a fieldset and legend
        provide clearer structure for users of assistive technologies.
    -->
    <fieldset class="mt-4">

        <legend class="h5 mb-3">
            Answer Options
        </legend>


        <!-- Answer A. -->
        <div class="form-group">

            <label asp-for="AnswerA"
                   class="form-label">
            </label>

            <span class="text-danger"
                  aria-hidden="true">*</span>
            <span class="visually-hidden">required</span>

            <input asp-for="AnswerA"
                   class="form-control"
                   aria-required="true" />

            <span asp-validation-for="AnswerA"
                  class="text-danger">
            </span>

        </div>


        <!-- Answer B. -->
        <div class="form-group mt-3">

            <label asp-for="AnswerB"
                   class="form-label">
            </label>

            <span class="text-danger"
                  aria-hidden="true">*</span>
            <span class="visually-hidden">required</span>

            <input asp-for="AnswerB"
                   class="form-control"
                   aria-required="true" />

            <span asp-validation-for="AnswerB"
                  class="text-danger">
            </span>

        </div>


        <!-- Answer C. -->
        <div class="form-group mt-3">

            <label asp-for="AnswerC"
                   class="form-label">
            </label>

            <span class="text-danger"
                  aria-hidden="true">*</span>
            <span class="visually-hidden">required</span>

            <input asp-for="AnswerC"
                   class="form-control"
                   aria-required="true" />

            <span asp-validation-for="AnswerC"
                  class="text-danger">
            </span>

        </div>


        <!-- Answer D. -->
        <div class="form-group mt-3">

            <label asp-for="AnswerD"
                   class="form-label">
            </label>

            <span class="text-danger"
                  aria-hidden="true">*</span>
            <span class="visually-hidden">required</span>

            <input asp-for="AnswerD"
                   class="form-control"
                   aria-required="true" />

            <span asp-validation-for="AnswerD"
                  class="text-danger">
            </span>

        </div>

    </fieldset>


    <!-- =====================================
         Correct answer
         ===================================== -->

    <div class="form-group mt-4">

        <label asp-for="CorrectAnswer"
               class="form-label fw-semibold">
            Correct Answer
        </label>

        <span class="text-danger"
              aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>

        <!-- Creates a dropdown containing the AnswerOption enum values. -->
        <select asp-for="CorrectAnswer"
                asp-items="Html.GetEnumSelectList<HMJT.Models.AnswerOption>()"
                class="form-select"
                aria-required="true">
        </select>

        <span asp-validation-for="CorrectAnswer"
              class="text-danger">
        </span>

    </div>


    <!-- =====================================
         Form actions
         ===================================== -->

    <div class="mt-4">

        <!-- Creates the question. -->
        <button type="submit"
                class="btn btn-primary">
            Create
        </button>

        <!-- Returns to the questions belonging to this game. -->
        <a asp-controller="Game"
           asp-action="Questions"
           asp-route-id="@Model.GameId"
           class="btn btn-secondary">
            Back to Questions
        </a>

    </div>

</form>


@section Scripts {

    <!-- Enables ASP.NET Core client-side validation. -->
    <partial name="_ValidationScriptsPartial" />

}