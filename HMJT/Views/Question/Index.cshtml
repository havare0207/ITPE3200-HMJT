@model IEnumerable<HMJT.Models.Question>

@{
// Sets the title for the page.
ViewData["Title"] = "Questions";
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
<h2 class="mb-0">Questions</h2>

<!-- Link to the page for creating a new question. -->

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New Question
    </a>
</p>
</div>
<!-- Displays all questions in a table. -->
<div class="table-responsive">
<table class="table table-bordered table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Question</th>
            <th>Category</th>
            <th>Difficulty</th>
            <th>Correct Answer</th>
            <th>Game Name</th>
            <th>Actions</th>
        </tr>
    </thead>


<tbody>
    <!-- Loops through every question supplied by the controller. -->
    @foreach (var question in Model)
    {
        <tr>
            <td>@question.QuestionText</td>
            <td>@question.Category</td>
            <td>@question.Difficulty</td>
            <td>@question.CorrectAnswer</td>
            <td>@question.Game?.Name</td>


            <td>
                <!-- Opens the details page for this question. -->
                <a asp-action="Details"
                   asp-route-id="@question.QuestionId"
                   class="btn btn-info btn-sm">
                    Details
                </a>

                <!-- Opens the edit page for this question. -->
                <a asp-action="Edit"
                   asp-route-id="@question.QuestionId"
                   class="btn btn-warning btn-sm">
                    Edit
                </a>

                <!-- Opens the delete confirmation page for this question. -->
                <a asp-action="Delete"
                   asp-route-id="@question.QuestionId"
                   class="btn btn-danger btn-sm">
                    Delete
                </a>
            </td>
        </tr>
    }
</tbody>


</table>
</div>