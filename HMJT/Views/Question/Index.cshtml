@model HMJT.ViewModels.QuestionIndexViewModel

@{
    // Sets the title for the page.
    ViewData["Title"] = "Questions";
}

<!-- Welcome heading and introduction. -->
<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <h2 class="mb-0">Explore Questions</h2>
        <span class="badge bg-primary">Explore</span>
    </div>

    <div class="welcome-banner p-4 p-md-5 mb-4 rounded-3 text-white">
        <h2>Welcome, Curious Mind! 🧠</h2>
        <p class="mb-3">
            Explore questions, discover new topics, and challenge your knowledge.
        </p>
        <p class="mb-0">
            Explore the question collection, discover different
            topics, and find the perfect question using the
            search and filters below. Let the quiz adventure begin!
        </p>
    </div>
</div>

<!-- Sends search and filter values to the Index GET action. -->
<form asp-controller="Question"
      asp-action="Index"
      method="get"
      class="question-search card border-0 shadow-sm p-3 p-md-4 mb-4">

    <div class="mb-3">
        <h5 class="fw-bold mb-1">
            <i class="bi bi-search me-2"></i>Find your next question
        </h5>
        <p class="text-muted small mb-0">
            Search by keyword or narrow down the results using the filters.
        </p>
    </div>

    <div class="row g-3">
        <!-- Keyword search connected to the ViewModel. -->
        <div class="col-12">
            <label asp-for="SearchString" class="form-label fw-semibold">
                Search questions
            </label>

            <div class="input-group">
                <span class="input-group-text bg-body">
                    <i class="bi bi-search"></i>
                </span>

                <input asp-for="SearchString"
                       class="form-control"
                       placeholder="e.g. What is a closing tag?..." />
            </div>
        </div>

        <!-- Category options come from the ViewModel. -->
        <div class="col-md-6">
            <label asp-for="Category" class="form-label">Category</label>
            <select asp-for="Category"
                    asp-items="Model.Categories"
                    class="form-select">
            </select>
        </div>

        <!-- Difficulty options come from the ViewModel. -->
        <div class="col-md-6">
            <label asp-for="Difficulty" class="form-label">Difficulty</label>
            <select asp-for="Difficulty"
                    asp-items="Model.Difficulties"
                    class="form-select">
            </select>
        </div>

        <!-- Game options come from the ViewModel. -->
        <div class="col-md-6">
            <label asp-for="GameName" class="form-label">Game</label>
            <select asp-for="GameName"
                    asp-items="Model.GameNames"
                    class="form-select">
            </select>
        </div>

        <!-- Search and clear buttons. -->
        <div class="col-12 d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-search me-1"></i>
                Search questions
            </button>

            <a asp-controller="Question"
               asp-action="Index"
               class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-counterclockwise me-1"></i>
                Clear filters
            </a>
        </div>
    </div>
</form>

<!-- Displays the number of matching questions. -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Questions</h5>
    <span class="badge bg-secondary">
        @Model.Questions.Count question(s)
    </span>
</div>

<!-- Displays questions supplied by the ViewModel. -->
<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Question</th>
                <th>Category</th>
                <th>Difficulty</th>
                <th>Correct Answer</th>
                <th>Game Name</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Questions.Any())
            {
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>@question.QuestionText</td>
                        <td>@question.Category</td>
                        <td>@question.Difficulty</td>
                        <td>@question.CorrectAnswer</td>
                        <td>@question.GameName</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4">
                        <i class="bi bi-search fs-3 d-block mb-2 text-muted"></i>
                        <strong>No questions found</strong>
                        <p class="text-muted mb-2">
                            Try another keyword or change your filters.
                        </p>
                        <a asp-controller="Question"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-sm">
                            Show all questions
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>