@model HMJT.ViewModels.QuestionViewModel

@{
    // Sets the title for the page.
    ViewData["Title"] = "Edit Question";
}

<h2>Edit Question</h2>

<!-- Sends the edited ViewModel to the Edit POST action. -->
<form asp-action="Edit" method="post">

    <!-- Keeps the QuestionId when the form is submitted. -->
    <input type="hidden" asp-for="QuestionId" />

    <!-- Keeps the GameId; the controller should verify ownership server-side. -->
    <input type="hidden" asp-for="GameId" />

    <!-- Displays model-level validation errors. -->
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="QuestionText"></label>
        <span class="text-danger">*</span>
        <input asp-for="QuestionText" class="form-control" />
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Category"></label>
        <span class="text-danger">*</span>

        <select asp-for="Category"
                asp-items="Model.Categories"
                class="form-select">
            <option value="">-- Select a category --</option>
        </select>

        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Difficulty"></label>
        <span class="text-danger">*</span>

        <select asp-for="Difficulty"
                asp-items="Model.Difficulties"
                class="form-select">
        </select>

        <span asp-validation-for="Difficulty" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="AnswerA"></label>
        <span class="text-danger">*</span>
        <input asp-for="AnswerA" class="form-control" />
        <span asp-validation-for="AnswerA" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="AnswerB"></label>
        <span class="text-danger">*</span>
        <input asp-for="AnswerB" class="form-control" />
        <span asp-validation-for="AnswerB" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="AnswerC"></label>
        <span class="text-danger">*</span>
        <input asp-for="AnswerC" class="form-control" />
        <span asp-validation-for="AnswerC" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="AnswerD"></label>
        <span class="text-danger">*</span>
        <input asp-for="AnswerD" class="form-control" />
        <span asp-validation-for="AnswerD" class="text-danger"></span>
    </div>

    <!-- Creates a dropdown containing the available answer options. -->
    <div class="form-group mt-3">
        <label asp-for="CorrectAnswer"></label>
        <span class="text-danger">*</span>

        <select asp-for="CorrectAnswer"
                asp-items="Html.GetEnumSelectList<HMJT.Models.AnswerOption>()"
                class="form-select">
        </select>

        <span asp-validation-for="CorrectAnswer" class="text-danger"></span>
    </div>

    <br />

    <!-- Saves the changes to the question. -->
    <button type="submit" class="btn btn-primary">Save Changes</button>

    <!-- Returns to the question list without saving. -->
    <a asp-controller="Game"
   asp-action="Questions"
   asp-route-id="@Model.GameId"
   class="btn btn-secondary">
    Back to Questions</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

