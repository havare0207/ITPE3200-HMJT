@model ErrorViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Error";
}

<!--
    Generic error page.

    The page gives the user useful information without displaying
    stack traces, file paths or other sensitive implementation details.
-->
<section class="card p-4 p-md-5"
         aria-labelledby="error-heading">

    <!-- Main error heading. -->
    <h1 id="error-heading"
        class="text-danger">
        Something went wrong
    </h1>

    <p>
        An unexpected error occurred while processing your request.
        Please try again later.
    </p>


    <!--
        Request ID can help developers identify the request in logs
        without exposing detailed exception information.
    -->
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong>
            <code>@Model.RequestId</code>
        </p>
    }


    <!-- Gives the user a clear route back into the application. -->
    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">

        Back to home

    </a>

</section>