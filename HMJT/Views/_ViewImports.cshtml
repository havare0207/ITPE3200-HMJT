@* Makes the main HMJT namespace available in Razor views. *@
@using HMJT

@* Makes model classes available without requiring
   the full namespace in every Razor view. *@
@using HMJT.Models

@* Enables ASP.NET Core Tag Helpers such as
   asp-controller, asp-action, asp-for and asp-validation-for. *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers