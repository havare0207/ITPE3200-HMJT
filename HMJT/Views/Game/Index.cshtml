@model HMJT.ViewModels.GameIndexViewModel

@{
    ViewData["Title"] = "Games";
}

<h2>My Games</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create New Game
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Times Played</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!--  Display each game supplied by the index ViewModel. -->
        @foreach (var game in Model.Games)
        {
            <tr>
                <td>@game.Name</td>
                <td>@game.TimesPlayed</td>
                <td>@game.CreatedAt</td>
                <td>
                    <a asp-action="Questions"
                       asp-route-id="@game.GameId"
                       class="btn btn-info">
                        Manage Questions
                    </a>

                    <a asp-action="Update"
                       asp-route-id="@game.GameId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@game.GameId"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>