@model IEnumerable<HMJT.Models.Game>

    @{ ViewData["Title"] = "Games"; 
    }

    <h2>My Games</h2>
    

    <a asp-action="Create" class="btn btn-primary mb-3">Create New Game</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td>@game.Name</td>
                    <td>@game.Status</td>
                    <td>@game.CurrentPosition</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@game.GameId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>