@model HMJT.ViewModels.GameViewModel

@{
    // Sets the browser/page title.
    ViewData["Title"] = "Edit Game";
}

<!-- Main page heading. -->
<h1>Edit Game</h1>

<!-- Explains the required-field marker.
     The visually-hidden text gives the same information
     to screen-reader users. -->
<p class="text-muted">
    Fields marked with
    <span class="text-danger" aria-hidden="true">*</span>
    <span class="visually-hidden">an asterisk</span>
    are required.
</p>

<!-- Sends the updated game data to the Update POST action. -->
<form asp-action="Update" method="post">

    <!-- Include an anti-forgery token to protect the POST request. -->
    @Html.AntiForgeryToken()

    <!-- Keeps the GameId when the form is submitted.
         The controller still verifies that the logged-in user
         owns the game before allowing the update. -->
    <input type="hidden" asp-for="GameId" />

    <!-- Show validation errors that are not connected
         to one specific field.
         role="alert" and aria-live help screen readers
         announce validation errors. -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger"
         role="alert"
         aria-live="polite">
    </div>

    <!-- Game name field. -->
    <div class="form-group mb-3">

        <!-- asp-for connects the label to the generated input ID. -->
        <label asp-for="Name" class="form-label"></label>

        <!-- Visible required-field marker.
             The asterisk itself is hidden from screen readers
             because the hidden text below describes it. -->
        <span class="text-danger" aria-hidden="true">*</span>
        <span class="visually-hidden">required</span>

        <!-- Input containing the current game name. -->
        <input asp-for="Name"
               class="form-control"
               aria-required="true" />

        <!-- Displays validation errors for the Name field. -->
        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <!-- Saves the edited game information. -->
    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <!-- Returns to My Games without saving changes. -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <!-- Enable ASP.NET Core client-side validation. -->
    <partial name="_ValidationScriptsPartial" />
}