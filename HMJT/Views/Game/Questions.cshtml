@model HMJT.ViewModels.GameQuestionsViewModel

@{
    ViewData["Title"] = "Game Questions";
}

<!-- Display the name of the game whose questions are being managed. -->
<h2>@Model.GameName - Questions</h2>

<div class="mb-3">
    <!--  Send the game ID so the new question is associated with this game. -->
    <a asp-controller="Question"
       asp-action="Create"
       asp-route-gameId="@Model.GameId"
       class="btn btn-primary">
        Add Question
    </a>

    <a asp-controller="Game"
       asp-action="Index"
       class="btn btn-secondary">
        Back to My Games
    </a>
</div>

<!--  Check whether the ViewModel contains any questions. -->
@if (Model.Questions.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Question</th>
                <th>Category</th>
                <th>Difficulty</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <!--  Display each question belonging to this game. -->
            @foreach (var question in Model.Questions)
            {
                <tr>
                    <td>@question.QuestionText</td>
                    <td>@question.Category</td>
                    <td>@question.Difficulty</td>
                    <td>
                        <a asp-controller="Question"
                           asp-action="Edit"
                           asp-route-id="@question.QuestionId"
                           class="btn btn-sm btn-secondary">
                            Edit
                        </a>

                        <a asp-controller="Question"
                           asp-action="Delete"
                           asp-route-id="@question.QuestionId"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <!--  Show a helpful message when the game has no questions yet. -->
    <p>This game does not have any questions yet.</p>
}