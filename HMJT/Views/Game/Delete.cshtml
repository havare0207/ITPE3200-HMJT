@model HMJT.Models.Game

<h2>Delete Game</h2>

<h3>Are you sure you want to delete this game?</h3>
<div>
    <h4>Game</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Game Id</dt>
        <dd class="col-sm-10">@Model.GameId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.GameId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
    
</div>