@model HMJT.ViewModels.GameViewModel

<h3 class="my-5">
    @Model.Name
</h3>

<div class="row gx-5">
    <div class="col-12">
        <h5>Status: @Model.Status</h5>
        <h5>Created At: @Model.CreatedAt</h5>

        <!-- Open the Questions action for this specific game. -->
        <div class="mt-3">
            <a asp-controller="Game"
               asp-action="Questions"
               asp-route-id="@Model.GameId"
               class="btn btn-primary">
                Manage Questions
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Back to Games
            </a>
        </div>
    </div>
</div>