@model HMJT.Models.GamePlayViewModel
@using HMJT.Models

@functions {
    // Builds the CSS class list for a wedge token
    // based on which category wedges the player owns.
    public static string GetWedgeTokenClass(
        HashSet<string> wedges,
        bool small = false)
    {
        List<string> classes = new()
        {
            "wedge-token"
        };

        if (small)
        {
            classes.Add("wedge-token-small");
        }

        if (wedges.Contains("Java"))
        {
            classes.Add("has-java");
        }

        if (wedges.Contains("Python"))
        {
            classes.Add("has-python");
        }

        if (wedges.Contains("C#"))
        {
            classes.Add("has-csharp");
        }

        if (wedges.Contains("HTML/CSS"))
        {
            classes.Add("has-html");
        }

        if (wedges.Contains("Game History"))
        {
            classes.Add("has-history");
        }

        if (wedges.Contains("JavaScript"))
        {
            classes.Add("has-javascript");
        }

        return string.Join(" ", classes);
    }
    // Returns the visual position of a board space.
    // The coordinates match the existing interactive board.
    public static string GetBoardSpacePosition(int boardSpaceId)
    {
        return boardSpaceId switch
        {
            1 => "--player-x: 39%; --player-y: 10%;",
            2 => "--player-x: 50%; --player-y: 8%;",
            3 => "--player-x: 61%; --player-y: 10%;",
            4 => "--player-x: 72%; --player-y: 15%;",
            5 => "--player-x: 82%; --player-y: 22%;",
            6 => "--player-x: 89%; --player-y: 32%;",
            7 => "--player-x: 93%; --player-y: 42%;",
            8 => "--player-x: 95%; --player-y: 50%;",
            9 => "--player-x: 93%; --player-y: 58%;",
            10 => "--player-x: 89%; --player-y: 68%;",
            11 => "--player-x: 82%; --player-y: 78%;",
            12 => "--player-x: 72%; --player-y: 85%;",
            13 => "--player-x: 61%; --player-y: 90%;",
            14 => "--player-x: 50%; --player-y: 92%;",
            15 => "--player-x: 39%; --player-y: 90%;",
            16 => "--player-x: 28%; --player-y: 85%;",
            17 => "--player-x: 18%; --player-y: 78%;",
            18 => "--player-x: 11%; --player-y: 68%;",
            19 => "--player-x: 7%; --player-y: 58%;",
            20 => "--player-x: 5%; --player-y: 50%;",
            21 => "--player-x: 7%; --player-y: 42%;",
            22 => "--player-x: 11%; --player-y: 32%;",
            23 => "--player-x: 18%; --player-y: 22%;",
            24 => "--player-x: 28%; --player-y: 15%;",

            25 => "--player-x: 50%; --player-y: 22%;",
            26 => "--player-x: 50%; --player-y: 31%;",
            27 => "--player-x: 50%; --player-y: 40%;",

            28 => "--player-x: 76%; --player-y: 35%;",
            29 => "--player-x: 68%; --player-y: 39.5%;",
            30 => "--player-x: 60%; --player-y: 44%;",

            31 => "--player-x: 76%; --player-y: 65%;",
            32 => "--player-x: 68%; --player-y: 60.5%;",
            33 => "--player-x: 60%; --player-y: 56%;",

            34 => "--player-x: 50%; --player-y: 78%;",
            35 => "--player-x: 50%; --player-y: 69%;",
            36 => "--player-x: 50%; --player-y: 60%;",

            37 => "--player-x: 24%; --player-y: 65%;",
            38 => "--player-x: 32%; --player-y: 60.5%;",
            39 => "--player-x: 40%; --player-y: 56%;",

            40 => "--player-x: 24%; --player-y: 35%;",
            41 => "--player-x: 32%; --player-y: 39.5%;",
            42 => "--player-x: 40%; --player-y: 44%;",

            // Center
            43 => "--player-x: 50%; --player-y: 50%;",

            _ => "--player-x: 50%; --player-y: 50%;"
        };
    }
}

@{
    ViewData["Title"] = "Play";

    // Find the current player so the final-retry rule can
    // be used when deciding which popup should be shown.
    PlayerGameState? currentPlayerState =
        Model.Players.FirstOrDefault(
            player => player.PlayerNumber == Model.PlayerNumber
        );

    // Show the winner popup when the game has ended.
    bool showWinnerPopup =
        Model.HasActiveGame &&
        Model.IsGameOver &&
        !string.IsNullOrWhiteSpace(Model.WinnerName);

    // Show the final-answer retry rule after a wrong
    // final answer. The GameplayController already sets
    // this message and the player's retry state.
    bool showWrongFinalAnswerPopup =
        Model.HasActiveGame &&
        !Model.IsGameOver &&
        !string.IsNullOrWhiteSpace(Model.Message) &&
        Model.Message.StartsWith(
            "Wrong final answer",
            StringComparison.OrdinalIgnoreCase
        );

    // Show the final-rule reminder when the current player
    // has all six wedges and is ready to roll toward center.
    // Do not show it while the special retry rule is active.
    bool showFinalRulePopup =
        Model.HasActiveGame &&
        !Model.IsGameOver &&
        Model.CanRollDice &&
        Model.MissingWedges.Count == 0 &&
        currentPlayerState?.MustLeaveCenterBeforeFinalRetry != true &&
        !showWrongFinalAnswerPopup;

    // Builds a text-only wedge summary for screen-reader announcements.
    // This ensures that wedge progress is communicated through text
    // rather than only through the colored wedge token.
    string collectedWedgeSummary =
        Model.Wedges.Count == 0
            ? "No wedges collected."
            : $"Collected wedges: {string.Join(", ", Model.Wedges)}.";

    // Combines the normal gameplay message with the current wedge progress.
    // JavaScript places this text into a live region after the page loads
    // so screen-reader users are notified about game-state changes.
    string gameplayScreenReaderAnnouncement =
        !string.IsNullOrWhiteSpace(Model.Message) &&
        Model.HasActiveGame
            ? $"{Model.Message} {Model.PlayerName} has collected " +
              $"{Model.Wedges.Count} of 6 wedges. {collectedWedgeSummary}"
            : string.Empty;
}

<!-- Show the setup form if no game is currently active. -->
@if (!Model.HasActiveGame)
{
    <!-- =====================================
         Game setup
         ===================================== -->

    <section class="game-setup-page">

        <div class="setup-page-heading">
            <p class="setup-eyebrow">
                LOCAL HOT-SEAT GAME
            </p>

            <h1>Set up a new game</h1>

            <p class="setup-intro">
                Enter 2–6 player names, choose one difficulty deck,
                then let the app randomly choose who starts.
            </p>
        </div>


        <div class="setup-page-layout">

            <!-- =====================================
                 Main setup form
                 ===================================== -->
            <div class="setup-main-card">

                <form asp-controller="Gameplay"
                      asp-action="StartGame"
                      method="post">

                    <!-- Displays setup or validation feedback.
                        role="alert" ensures important feedback is announced
                        by assistive technologies when the page is displayed. -->
                    @if (!string.IsNullOrWhiteSpace(Model.Message))
                    {
                        <div class="alert alert-warning"
                            role="alert"
                            aria-live="polite">
                            @Model.Message
                        </div>
                    }


                    <!-- =====================================
                         Game mode
                         ===================================== -->

                    <!--
                        Standard Game and Custom Game are one logical
                        radio-button group. A fieldset and legend make
                        that relationship clear to screen-reader users.
                    -->
                    <fieldset class="mb-4">

                        <legend class="h2">
                            1. Game mode
                        </legend>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <div class="card h-100 p-3">

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="gameMode"
                                               id="standardGameMode"
                                               value="@GameMode.Standard"
                                               aria-describedby="standardGameDescription"
                                               checked />

                                        <label class="form-check-label fw-bold"
                                               for="standardGameMode">
                                            Standard Game
                                        </label>
                                    </div>

                                    <p id="standardGameDescription"
                                       class="text-muted mt-2 mb-0">
                                        Play using the standard Code Pursuit
                                        question set.
                                    </p>

                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="card h-100 p-3">

                                    <div class="form-check">

                                        @if (User.Identity?.IsAuthenticated == true &&
                                             Model.CustomGames.Any())
                                        {
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="gameMode"
                                                   id="customGameMode"
                                                   value="@GameMode.Custom"
                                                   aria-describedby="customGameModeDescription" />
                                        }
                                        else
                                        {
                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="gameMode"
                                                   id="customGameMode"
                                                   aria-describedby="customGameModeDescription"
                                                   disabled />
                                        }

                                        <label class="form-check-label fw-bold"
                                               for="customGameMode">
                                            Custom Game
                                        </label>

                                    </div>

                                    @if (User.Identity?.IsAuthenticated != true)
                                    {
                                        <p id="customGameModeDescription"
                                           class="text-muted mt-2 mb-0">
                                            Login or register to use custom games.
                                        </p>
                                    }
                                    else if (!Model.CustomGames.Any())
                                    {
                                        <p id="customGameModeDescription"
                                           class="text-muted mt-2 mb-0">
                                            Create a custom game under My Games first.
                                        </p>
                                    }
                                    else
                                    {
                                        <p id="customGameModeDescription"
                                           class="text-muted mt-2 mb-0">
                                            Play using one of your saved custom games.
                                        </p>
                                    }

                                </div>
                            </div>

                        </div>

                    </fieldset>


                    <!-- =====================================
                         Custom game selection
                         ===================================== -->

                    @if (User.Identity?.IsAuthenticated == true &&
                         Model.CustomGames.Any())
                    {
                        <!-- This section is hidden until Custom Game
                             is selected above. -->
                        <div id="customGameSelection"
                             class="mb-4"
                             role="region"
                             aria-labelledby="customGameSelectionHeading"
                             aria-hidden="true"
                             style="display: none;">

                            <h2 id="customGameSelectionHeading"
                                class="h5">
                                Choose your custom game
                            </h2>

                            <!-- The label is explicitly connected to the custom-game dropdown. -->
                            <label for="customGameId"
                                class="form-label fw-bold">
                                Custom game
                            </label>

                            <!-- aria-describedby connects the explanatory help text
                                below to the dropdown for screen-reader users. -->
                            <select id="customGameId"
                                    name="customGameId"
                                    class="form-select"
                                    aria-describedby="customGameHelp">

                                <option value="">
                                    Select a custom game...
                                </option>

                                @foreach (Game game in Model.CustomGames)
                                {
                                    <option value="@game.GameId">
                                        @game.Name
                                    </option>
                                }

                            </select>

                            <div id="customGameHelp"
                                class="form-text">
                                Only custom games belonging to your
                                logged-in account are shown here.
                            </div>

                        </div>
                    }


                    <!-- =====================================
                         Player names
                         ===================================== -->

                    <h2>2. Players</h2>

                    <div class="setup-player-grid">

                        <div class="setup-player-field">
                            <label for="player1">
                                Player 1
                            </label>

                            <input type="text"
                                   id="player1"
                                   name="player1"
                                   class="form-control"
                                   placeholder="Alex" />
                        </div>


                        <div class="setup-player-field">
                            <label for="player2">
                                Player 2
                            </label>

                            <input type="text"
                                   id="player2"
                                   name="player2"
                                   class="form-control"
                                   placeholder="Emma" />
                        </div>


                        <div class="setup-player-field">
                            <label for="player3">
                                Player 3
                                <span>(optional)</span>
                            </label>

                            <input type="text"
                                   id="player3"
                                   name="player3"
                                   class="form-control"
                                   placeholder="Optional" />
                        </div>


                        <div class="setup-player-field">
                            <label for="player4">
                                Player 4
                                <span>(optional)</span>
                            </label>

                            <input type="text"
                                   id="player4"
                                   name="player4"
                                   class="form-control"
                                   placeholder="Optional" />
                        </div>


                        <div class="setup-player-field">
                            <label for="player5">
                                Player 5
                                <span>(optional)</span>
                            </label>

                            <input type="text"
                                   id="player5"
                                   name="player5"
                                   class="form-control"
                                   placeholder="Optional" />
                        </div>


                        <div class="setup-player-field">
                            <label for="player6">
                                Player 6
                                <span>(optional)</span>
                            </label>

                            <input type="text"
                                   id="player6"
                                   name="player6"
                                   class="form-control"
                                   placeholder="Optional" />
                        </div>

                    </div>


                    <!-- =====================================
                         Difficulty
                         ===================================== -->

                    <!--
                        Difficulty choices form one radio-button group.
                        The fieldset/legend structure lets screen readers
                        announce the group and allows normal arrow-key
                        navigation between Easy, Medium and Hard.
                    -->
                    <fieldset class="mt-4">

                        <legend class="h2 setup-difficulty-heading">
                            3. Question difficulty
                        </legend>

                        <div class="difficulty-card-grid">

                            <label class="difficulty-card difficulty-easy"
                                   for="difficultyEasy">

                                <input type="radio"
                                       id="difficultyEasy"
                                       name="difficulty"
                                       value="@Difficulty.Easy"
                                       aria-describedby="difficultyEasyDescription"
                                       checked />

                                <span class="difficulty-radio"
                                      aria-hidden="true">
                                </span>

                                <span class="difficulty-icon"
                                      aria-hidden="true">
                                    &lt;/&gt;
                                </span>

                                <strong>Easy</strong>

                                <span id="difficultyEasyDescription"
                                      class="difficulty-description">
                                    Core concepts and straightforward questions.
                                </span>

                            </label>


                            <label class="difficulty-card difficulty-medium"
                                   for="difficultyMedium">

                                <input type="radio"
                                       id="difficultyMedium"
                                       name="difficulty"
                                       value="@Difficulty.Medium"
                                       aria-describedby="difficultyMediumDescription" />

                                <span class="difficulty-radio"
                                      aria-hidden="true">
                                </span>

                                <span class="difficulty-icon"
                                      aria-hidden="true">
                                    💡
                                </span>

                                <strong>Medium</strong>

                                <span id="difficultyMediumDescription"
                                      class="difficulty-description">
                                    More reasoning and short code examples.
                                </span>

                            </label>


                            <label class="difficulty-card difficulty-hard"
                                   for="difficultyHard">

                                <input type="radio"
                                       id="difficultyHard"
                                       name="difficulty"
                                       value="@Difficulty.Hard"
                                       aria-describedby="difficultyHardDescription" />

                                <span class="difficulty-radio"
                                      aria-hidden="true">
                                </span>

                                <span class="difficulty-icon"
                                      aria-hidden="true">
                                    ★
                                </span>

                                <strong>Hard</strong>

                                <span id="difficultyHardDescription"
                                      class="difficulty-description">
                                    Trickier language details and deeper concepts.
                                </span>

                            </label>

                        </div>

                    </fieldset>


                    <!-- The existing StartGame action is still used.
                         The intermediate starter screen comes in step 2. -->
                    <button type="submit"
                            class="setup-start-button">

                        Choose starting player

                    </button>

                </form>

            </div>


            <!-- =====================================
                 Setup information panel
                 ===================================== -->
            <aside class="setup-info-card">

                <div class="setup-deck-preview"
                     aria-hidden="true">

                    <div class="setup-deck-card deck-easy">
                        <span>&lt;/&gt;</span>
                        <strong>EASY</strong>
                    </div>

                    <div class="setup-deck-card deck-medium">
                        <span>💡</span>
                        <strong>MEDIUM</strong>
                    </div>

                    <div class="setup-deck-card deck-hard">
                        <span>★</span>
                        <strong>HARD</strong>
                    </div>

                </div>


                <h3>One deck per game</h3>

                <p>
                    The difficulty stays the same for all six
                    categories until the game ends.
                </p>


                <div class="setup-info-stat">
                    <strong>2–6</strong>
                    <span>local players</span>
                </div>

                <div class="setup-info-stat">
                    <strong>6</strong>
                    <span>categories to collect</span>
                </div>

                <div class="setup-info-stat">
                    <strong>1 PC</strong>
                    <span>pass the screen between turns</span>
                </div>

            </aside>

        </div>

    </section>

}
else if (Model.IsAwaitingStartConfirmation)
{
    <!-- =====================================
         Starter selected screen
         ===================================== -->

    <section class="starter-selected-page">

        <div class="starter-selected-card">

            <p class="starter-eyebrow">
                STARTER SELECTED
            </p>

            <div class="starter-dice"
                 aria-hidden="true">
                🎲
            </div>

            <h1>
                @Model.PlayerName starts!
            </h1>

            <p class="starter-description">
                The starter was chosen randomly.
                Difficulty:
                <strong>@Model.SelectedDifficulty</strong>.
            </p>

            <!-- Shows all players in the game.
                 The randomly selected starter is highlighted. -->
            <div class="starter-player-list">

                <!-- Lists all players.
                    The starting player is identified both visually
                    and with hidden text for screen-reader users. -->
                @foreach (PlayerGameState player in Model.Players)
                {
                    <span class="starter-player-chip
                                @(player.PlayerNumber == Model.PlayerNumber
                                    ? "starter-player-chip-selected"
                                    : "")">

                        @player.PlayerName

                        @if (player.PlayerNumber == Model.PlayerNumber)
                        {
                            <span class="visually-hidden">
                                - starting player
                            </span>
                        }

                    </span>
                }

            </div>

            <!-- Continue to the actual game board. -->
            <form asp-controller="Gameplay"
                  asp-action="ConfirmStartGame"
                  method="post">

                <button type="submit"
                        class="starter-start-button">

                    Start game

                </button>

            </form>

            <!-- Return to the setup screen. -->
            <form asp-controller="Gameplay"
                  asp-action="ChangeSetup"
                  method="post">

                <button type="submit"
                        class="starter-change-button">

                    Change setup

                </button>

            </form>

        </div>

    </section>
}
else
{
    <!-- Top area containing the page title and reset button. -->
    <div class="gameplay-heading">

        <div>
            <h1>Code Pursuit</h1>
        </div>

        <!-- Allows the current game to be reset at any time. -->
        <form asp-controller="Gameplay"
              asp-action="ResetGame"
              method="post">

            <button type="submit"
                    class="btn btn-outline-danger">
                Reset Game
            </button>

        </form>

    </div>

    <!-- Displays gameplay feedback visually. -->
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="gameplay-status">
            @Model.Message
        </div>
    }

    <!--
        Empty live region used only by assistive technologies.
        JavaScript fills this region after the page has loaded.
    -->
    <div id="gameplayScreenReaderStatus"
         class="visually-hidden"
         role="status"
         aria-live="polite"
         aria-atomic="true"
         data-announcement="@gameplayScreenReaderAnnouncement">
    </div>

    <!-- Main gameplay area.
         The interactive board is shown on the left
         and current game information is shown on the right. -->
    <div class="gameplay-layout">

        <!-- Interactive board panel. -->
        <section class="gameplay-board-panel">

            <h2>Interactive Board</h2>

            <!-- Show movement instructions after the dice has been rolled. -->
            @if (Model.IsWaitingForMove)
            {
                <p>
                    Dice roll:
                    <strong>@Model.DiceRoll</strong>.
                    Choose one of the highlighted spaces.
                </p>
            }
            else
            {
                <p class="text-muted">
                    Roll the dice to see where you can move.
                </p>
            }

            <!-- Board legend.
                Category names are provided as text so information
                is not communicated through color alone. -->
            <div class="board-key"
                aria-label="Board category legend">

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #3182e8;"
                        aria-hidden="true">
                    </span>
                    Java
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #f6ca46;"
                        aria-hidden="true">
                    </span>
                    Python
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #9748dc;"
                        aria-hidden="true">
                    </span>
                    C#
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #f59a45;"
                        aria-hidden="true">
                    </span>
                    HTML/CSS
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #25ad63;"
                        aria-hidden="true">
                    </span>
                    JavaScript
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #ec407a;"
                        aria-hidden="true">
                    </span>
                    Game History
                </span>

            </div>

            @{
                // Returns true when a board space is one of
                // the legal destinations for the current dice roll.
                bool IsLegalDestination(int boardSpaceId)
                {
                    return Model.IsWaitingForMove &&
                           Model.LegalDestinationIds.Contains(boardSpaceId);
                }
            }

            <!-- Contains the circular game board. -->
            <div class="interactive-board-shell">

                <!-- All board buttons use the same form.
                     Clicking a legal space sends its BoardSpaceId
                     to GameplayController.Move. -->
                <form asp-controller="Gameplay"
                      asp-action="Move"
                      method="post"
                      class="board-move-form">

                    <!-- Interactive game board.
                        The individual legal destinations already have descriptive
                        aria-label attributes, while this label gives the entire
                        board a meaningful name for assistive technologies. -->
                    <div class="interactive-board"
                        role="group"
                        aria-label="Code Pursuit interactive game board">

                        <!-- =====================================
                             Category labels
                             ===================================== -->

                        <span class="board-category-label
                                     board-category-history">
                            Game<br />
                            History
                        </span>

                        <span class="board-category-label
                                     board-category-java">
                            Java
                        </span>

                        <span class="board-category-label
                                     board-category-python">
                            Python
                        </span>

                        <span class="board-category-label
                                     board-category-csharp">
                            C#
                        </span>

                        <span class="board-category-label
                                     board-category-html">
                            HTML/CSS
                        </span>

                        <span class="board-category-label
                                     board-category-javascript">
                            JavaScript
                        </span>


                        <!-- =====================================
                             Outer ring - top
                             ===================================== -->

                        <!-- Space 24: Roll Again -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="24"
                                class="board-space roll-again @(IsLegalDestination(24) ? "legal-destination" : "")"
                                style="--x: 28%; --y: 15%;"
                                disabled="@(IsLegalDestination(24) ? null : "disabled")"
                                aria-label="Move to Roll Again space">
                            <span class="roll-again-text">
                                ROLL
                            </span>
                        </button>

                        <!-- Space 1: C# -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="1"
                                class="board-space @(IsLegalDestination(1) ? "legal-destination" : "")"
                                style="--x: 39%; --y: 10%;
                                       --space-color: #9748dc;"
                                disabled="@(IsLegalDestination(1) ? null : "disabled")"
                                aria-label="Move to C sharp space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 2: Game History -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="2"
                                class="board-space @(IsLegalDestination(2) ? "legal-destination" : "")"
                                style="--x: 50%; --y: 8%;
                                       --space-color: #ec407a;"
                                disabled="@(IsLegalDestination(2) ? null : "disabled")"
                                aria-label="Move to Game History space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 3: JavaScript -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="3"
                                class="board-space @(IsLegalDestination(3) ? "legal-destination" : "")"
                                style="--x: 61%; --y: 10%;
                                       --space-color: #25ad63;"
                                disabled="@(IsLegalDestination(3) ? null : "disabled")"
                                aria-label="Move to JavaScript space">
                            <span class="board-space-marker"></span>
                        </button>

