@model HMJT.Models.GamePlayViewModel
@using HMJT.Models

@functions {
    // Builds the CSS class list for a wedge token
    // based on which category wedges the player owns.
    public static string GetWedgeTokenClass(
        HashSet<string> wedges,
        bool small = false)
    {
        List<string> classes = new()
        {
            "wedge-token"
        };

        if (small)
        {
            classes.Add("wedge-token-small");
        }

        if (wedges.Contains("Java"))
        {
            classes.Add("has-java");
        }

        if (wedges.Contains("Python"))
        {
            classes.Add("has-python");
        }

        if (wedges.Contains("C#"))
        {
            classes.Add("has-csharp");
        }

        if (wedges.Contains("HTML/CSS"))
        {
            classes.Add("has-html");
        }

        if (wedges.Contains("Game History"))
        {
            classes.Add("has-history");
        }

        if (wedges.Contains("JavaScript"))
        {
            classes.Add("has-javascript");
        }

        return string.Join(" ", classes);
    }
}

@{
    ViewData["Title"] = "Play";
}

<!-- Show the setup form if no game is currently active. -->
@if (!Model.HasActiveGame)
{
    <h1>Game</h1>

    <h2>Start New Game</h2>

    <!-- Show validation or setup messages before the game starts. -->
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning">
            @Model.Message
        </div>
    }

    <!-- Sends player names and difficulty to StartGame. -->
    <form asp-controller="Gameplay"
          asp-action="StartGame"
          method="post">

        <div class="mb-3">
            <label for="player1" class="form-label">
                Player 1
            </label>

            <input type="text"
                   id="player1"
                   name="player1"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player2" class="form-label">
                Player 2
            </label>

            <input type="text"
                   id="player2"
                   name="player2"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player3" class="form-label">
                Player 3
            </label>

            <input type="text"
                   id="player3"
                   name="player3"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player4" class="form-label">
                Player 4
            </label>

            <input type="text"
                   id="player4"
                   name="player4"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player5" class="form-label">
                Player 5
            </label>

            <input type="text"
                   id="player5"
                   name="player5"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player6" class="form-label">
                Player 6
            </label>

            <input type="text"
                   id="player6"
                   name="player6"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="difficulty" class="form-label">
                Difficulty
            </label>

            <select id="difficulty"
                    name="difficulty"
                    class="form-select">

                <option value="@Difficulty.Easy">
                    Easy
                </option>

                <option value="@Difficulty.Medium">
                    Medium
                </option>

                <option value="@Difficulty.Hard">
                    Hard
                </option>

            </select>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Start Game
        </button>

    </form>
}
