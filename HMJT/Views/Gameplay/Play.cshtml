                    <!-- Show the current question after
                         a question turn has started. -->
                    @if (Model.HasActiveTurn)
                    {
                        @if (!Model.IsFinalTurn)
                        {
                            <p>
                                Dice roll:
                                <strong>@Model.DiceRoll</strong>
                            </p>
                        }

                        <p>
                            Category:
                            <strong>@Model.Category</strong>
                        </p>

                        <h3>
                            @Model.Question.QuestionText
                        </h3>

                        <!-- Sends the selected answer
                             to GameplayController.SubmitAnswer. -->
                        <form asp-controller="Gameplay"
                              asp-action="SubmitAnswer"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.A"
                                        class="btn btn-outline-primary">
                                    A: @Model.Question.AnswerA
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.B"
                                        class="btn btn-outline-primary">
                                    B: @Model.Question.AnswerB
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.C"
                                        class="btn btn-outline-primary">
                                    C: @Model.Question.AnswerC
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.D"
                                        class="btn btn-outline-primary">
                                    D: @Model.Question.AnswerD
                                </button>

                            </div>

                        </form>
                    }
                }

            </section>


            <!-- Shows wedge progress for the current player.
                 A visual six-piece player token will be added later
                 in addition to this text representation. -->
            <section class="gameplay-sidebar-card">

                <h3>Collected Wedges</h3>

                <!-- Shows a visual token that fills up
                    as the player collects wedges. -->
                <div class="wedge-progress-visual">

                    <!-- Visual representation of collected wedges.
                        The adjacent text list contains the same information,
                        so users do not have to understand the colors alone. -->
                    <div class="@GetWedgeTokenClass(Model.Wedges)"
                        role="img"
                        aria-label="@Model.PlayerName has collected @Model.Wedges.Count of 6 category wedges">
                    </div>

                    <div>
                        @if (Model.Wedges.Count == 0)
                        {
                            <p>
                                No wedges collected yet.
                            </p>
                        }
                        else
                        {
                            <ul>
                                @foreach (string wedge in Model.Wedges)
                                {
                                    <li>@wedge</li>
                                }
                            </ul>
                        }
                    </div>

                </div>

                <h3>Missing Wedges</h3>

                @if (Model.MissingWedges.Count == 0)
                {
                    <p>
                        All wedges collected!
                    </p>
                }
                else
                {
                    <ul>
                        @foreach (string wedge in Model.MissingWedges)
                        {
                            <li>@wedge</li>
                        }
                    </ul>
                }

                <h3>Players</h3>

                <div class="player-token-list">

                    @foreach (PlayerGameState player in Model.Players)
                    {
                        <!-- Player summary.
                            The current player is identified programmatically
                            in addition to the existing visual highlight. -->
                        <div class="player-token-item @(player.PlayerNumber == Model.PlayerNumber ? "current-player-token" : "")"
                            aria-current="@(player.PlayerNumber == Model.PlayerNumber ? "true" : null)">

                            <!-- Visual wedge token. Text beside the token gives
                                the same progress information without relying on color. -->
                            <div class="@GetWedgeTokenClass(player.Wedges, true)"
                                role="img"
                                aria-label="@player.PlayerName has collected @player.Wedges.Count of 6 wedges">
                            </div>

                            <div class="player-token-text">
                                <p class="player-token-name">
                                    P@(player.PlayerNumber). (@player.PlayerName)
                                </p>

                                <p class="player-token-space">
                                    Board space: @player.BoardSpaceId
                                </p>

                                <p class="player-token-space">
                                    @player.Wedges.Count / 6 wedges collected
                                </p>
                            </div>

                        </div>
                    }

                </div>

            </section>

        </aside>

    </div>
}

<!-- =====================================
     End-game and final-rule popups
     ===================================== -->

@if (showWinnerPopup)
{
    <!-- Winner popup. The game cannot continue after a winner exists. -->
    <div class="modal fade"
         id="winnerModal"
         tabindex="-1"
         aria-labelledby="winnerModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title h5"
                        id="winnerModalLabel">
                        Winner!
                    </h2>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        <strong>@Model.WinnerName</strong> won the game!
                    </p>
                </div>

                <div class="modal-footer">
                    <form asp-controller="Gameplay"
                          asp-action="ResetGame"
                          method="post">

                        <button type="submit"
                                class="btn btn-primary">
                            Reset Game
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
}

@if (showFinalRulePopup)
{
    <!-- Reminder shown when the current player has all six wedges. -->
    <div class="modal fade"
         id="finalRuleModal"
         tabindex="-1"
         aria-labelledby="finalRuleModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title h5"
                        id="finalRuleModalLabel">
                        Final Question Unlocked
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        <strong>@Model.PlayerName</strong> has collected all six wedges.
                    </p>

                    <p class="mb-0">
                        Reach the center of the board to attempt the final question.
                        The other players will choose the category.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-dismiss="modal">
                        Continue
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (showWrongFinalAnswerPopup)
{
    <!-- Explains the retry rule after an incorrect final answer. -->
    <div class="modal fade"
         id="wrongFinalAnswerModal"
         tabindex="-1"
         aria-labelledby="wrongFinalAnswerModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h2 class="modal-title h5"
                        id="wrongFinalAnswerModalLabel">
                        Wrong Final Answer
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        The final answer was incorrect.
                    </p>

                    <p>
                        You must leave the center and return before attempting
                        another final question.
                    </p>

                    <p class="mb-0">
                        If you roll a 6 while still in the center, you may choose
                        the center again immediately instead.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-dismiss="modal">
                        Continue
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<!-- =====================================
     Game mode setup script
     ===================================== -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Get the two game-mode radio buttons.
        const standardGameMode =
            document.getElementById("standardGameMode");

        const customGameMode =
            document.getElementById("customGameMode");

        // Get the custom-game dropdown container.
        // This element only exists when the logged-in
        // user has at least one saved custom game.
        const customGameSelection =
            document.getElementById("customGameSelection");


        // Shows the custom-game dropdown only when
        // Custom Game mode is selected.
        function updateGameModeDisplay() {

            if (!customGameSelection ||
                !customGameMode) {
                return;
            }

            const customSelected =
                customGameMode.checked;

            customGameSelection.style.display =
                customSelected
                    ? "block"
                    : "none";

            // Keep the accessibility tree synchronized
            // with the visual visibility of the controls.
            customGameSelection.setAttribute(
                "aria-hidden",
                customSelected ? "false" : "true"
            );
        }


        // Update the page whenever Standard Game
        // is selected.
        if (standardGameMode) {
            standardGameMode.addEventListener(
                "change",
                updateGameModeDisplay
            );
        }


        // Update the page whenever Custom Game
        // is selected. Disabled radio buttons are
        // ignored for logged-out users or users
        // without saved custom games.
        if (customGameMode &&
            !customGameMode.disabled) {
            customGameMode.addEventListener(
                "change",
                updateGameModeDisplay
            );
        }


        // Set the correct initial visibility
        // when the page first loads.
        updateGameModeDisplay();
    });
</script>

<!-- =====================================
     Screen-reader gameplay announcement
     ===================================== -->

<script>
    window.addEventListener("load", function () {

        const screenReaderStatus =
            document.getElementById("gameplayScreenReaderStatus");

        if (!screenReaderStatus) {
            return;
        }

        const announcement =
            screenReaderStatus.dataset.announcement;

        if (!announcement) {
            return;
        }

        // The live region starts empty and is populated after load,
        // which makes gameplay updates more reliably announced.
        window.setTimeout(function () {
            screenReaderStatus.textContent = announcement;
        }, 150);
    });
</script>

<!-- =====================================
     Popup display script
     ===================================== -->

<script>
    window.addEventListener("load", function () {

        // Clear one-time final-rule reminders after a game
        // has been reset and the setup page is shown again.
        @if (!Model.HasActiveGame)
        {
            <text>
            Object.keys(sessionStorage)
                .filter(key =>
                    key.startsWith("codepursuit-final-rule-"))
                .forEach(key =>
                    sessionStorage.removeItem(key));
            </text>
        }

        // Winner popup. This cannot be dismissed without
        // resetting the game.
        const winnerModalElement =
            document.getElementById("winnerModal");

        if (winnerModalElement) {
            const winnerModal =
                new bootstrap.Modal(
                    winnerModalElement,
                    {
                        backdrop: "static",
                        keyboard: false
                    }
                );

            winnerModal.show();
            return;
        }

        // Wrong-final-answer popup. This explains both
        // ways the player can become eligible to retry.
        const wrongFinalAnswerModalElement =
            document.getElementById("wrongFinalAnswerModal");

        if (wrongFinalAnswerModalElement) {
            const wrongFinalAnswerModal =
                new bootstrap.Modal(
                    wrongFinalAnswerModalElement
                );

            wrongFinalAnswerModal.show();
            return;
        }

        // Show the six-wedge reminder only once for each
        // player during the current game.
        const finalRuleModalElement =
            document.getElementById("finalRuleModal");

        if (finalRuleModalElement) {
            const storageKey =
                "codepursuit-final-rule-@Model.PlayerNumber";

            if (sessionStorage.getItem(storageKey) !== "shown") {
                const finalRuleModal =
                    new bootstrap.Modal(
                        finalRuleModalElement
                    );

                finalRuleModal.show();
                sessionStorage.setItem(storageKey, "shown");
            }
        }
    });
</script>

