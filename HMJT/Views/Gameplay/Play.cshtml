@model HMJT.Models.GamePlayViewModel
@using HMJT.Models

@{
    ViewData["Title"] = "Play";
}

<!-- Show the setup form if no game is currently active. -->
@if (!Model.HasActiveGame)
{
    <h1>Game</h1>

    <h2>Start New Game</h2>

    <!-- Show validation or setup messages before the game starts. -->
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-warning">
            @Model.Message
        </div>
    }

    <!-- Sends player names and difficulty to StartGame. -->
    <form asp-controller="Gameplay"
          asp-action="StartGame"
          method="post">

        <div class="mb-3">
            <label for="player1" class="form-label">
                Player 1
            </label>

            <input type="text"
                   id="player1"
                   name="player1"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player2" class="form-label">
                Player 2
            </label>

            <input type="text"
                   id="player2"
                   name="player2"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player3" class="form-label">
                Player 3
            </label>

            <input type="text"
                   id="player3"
                   name="player3"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player4" class="form-label">
                Player 4
            </label>

            <input type="text"
                   id="player4"
                   name="player4"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player5" class="form-label">
                Player 5
            </label>

            <input type="text"
                   id="player5"
                   name="player5"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="player6" class="form-label">
                Player 6
            </label>

            <input type="text"
                   id="player6"
                   name="player6"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label for="difficulty" class="form-label">
                Difficulty
            </label>

            <select id="difficulty"
                    name="difficulty"
                    class="form-select">

                <option value="@Difficulty.Easy">
                    Easy
                </option>

                <option value="@Difficulty.Medium">
                    Medium
                </option>

                <option value="@Difficulty.Hard">
                    Hard
                </option>

            </select>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Start Game
        </button>
    </form>
}
else
{
    <!-- Top area containing the page title and reset button. -->
    <div class="gameplay-heading">

        <div>
            <h1>Code Pursuit</h1>
        </div>

        <!-- Allows the current game to be reset at any time. -->
        <form asp-controller="Gameplay"
              asp-action="ResetGame"
              method="post">

            <button type="submit"
                    class="btn btn-outline-danger">
                Reset Game
            </button>
        </form>

    </div>

    <!-- Show feedback from the latest game action. -->
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="gameplay-status">
            @Model.Message
        </div>
    }

    <!-- Main gameplay area.
         The board is shown on the left and
         game information is shown on the right. -->
    <div class="gameplay-layout">

        <!-- Board panel.
             The actual interactive board will be added
             in the next development step. -->
        <section class="gameplay-board-panel">

            <!-- Heading and explanation for the game board. -->
            <h2>Interactive Board</h2>

            <p class="text-muted">
                Player positions and board movement will be added
                in the next steps.
            </p>

            <!-- Shows which color belongs to each category. -->
            <div class="board-key">

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #3182e8;">
                    </span>
                    Java
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #f6ca46;">
                    </span>
                    Python
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #9748dc;">
                    </span>
                    C#
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #f59a45;">
                    </span>
                    HTML/CSS
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #ec407a;">
                    </span>
                    Game History
                </span>

                <span class="board-key-item">
                    <span class="board-key-color"
                        style="background: #25ad63;">
                    </span>
                    JavaScript
                </span>

            </div>

            <!-- Circular six-category game board. -->
            <div class="interactive-board-shell">

                <div class="interactive-board">

                    <!-- =====================================
                        Category labels
                        ===================================== -->

                    <span class="board-category-label
                                board-category-history">
                        Game<br />
                        History
                    </span>

                    <span class="board-category-label
                                board-category-java">
                        Java
                    </span>

                    <span class="board-category-label
                                board-category-python">
                        Python
                    </span>

                    <span class="board-category-label
                                board-category-csharp">
                        C#
                    </span>

                    <span class="board-category-label
                                board-category-html">
                        HTML/CSS
                    </span>

                    <span class="board-category-label
                                board-category-javascript">
                        JavaScript
                    </span>


                    <!-- =====================================
                        Outer ring - top
                        Three normal spaces between
                        the two Roll Again spaces.
                        ===================================== -->

                    <div class="board-space roll-again"
                        style="--x: 28%; --y: 15%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>

                    <div class="board-space"
                        style="--x: 39%; --y: 10%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 50%; --y: 8%;
                                --space-color: #ec407a;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 61%; --y: 10%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space roll-again"
                        style="--x: 72%; --y: 15%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>


                    <!-- =====================================
                        Outer ring - upper right
                        ===================================== -->

                    <div class="board-space"
                        style="--x: 82%; --y: 22%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 89%; --y: 32%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 93%; --y: 42%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space roll-again"
                        style="--x: 95%; --y: 50%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>


                    <!-- =====================================
                        Outer ring - lower right
                        ===================================== -->

                    <div class="board-space"
                        style="--x: 93%; --y: 58%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 89%; --y: 68%;
                                --space-color: #ec407a;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 82%; --y: 78%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space roll-again"
                        style="--x: 72%; --y: 85%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>


                    <!-- =====================================
                        Outer ring - bottom
                        ===================================== -->

                    <div class="board-space"
                        style="--x: 61%; --y: 90%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 50%; --y: 92%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 39%; --y: 90%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space roll-again"
                        style="--x: 28%; --y: 85%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>


                    <!-- =====================================
                        Outer ring - lower left
                        ===================================== -->

                    <div class="board-space"
                        style="--x: 18%; --y: 78%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 11%; --y: 68%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 7%; --y: 58%;
                                --space-color: #ec407a;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space roll-again"
                        style="--x: 5%; --y: 50%;">
                        <span class="roll-again-text">
                            ROLL
                        </span>
                    </div>


                    <!-- =====================================
                        Outer ring - upper left
                        ===================================== -->

                    <div class="board-space"
                        style="--x: 7%; --y: 42%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 11%; --y: 32%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space"
                        style="--x: 18%; --y: 22%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        Game History path
                        Three spaces leading toward center.
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 22%;
                                --space-color: #ec407a;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 31%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 40%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        Java path
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 76%; --y: 35%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 68%; --y: 39.5%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 60%; --y: 44%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        Python path
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 76%; --y: 65%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 68%; --y: 60.5%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 60%; --y: 56%;
                                --space-color: #ec407a;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        C# path
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 78%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 69%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 50%; --y: 60%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        HTML/CSS path
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 24%; --y: 65%;
                                --space-color: #f59a45;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 32%; --y: 60.5%;
                                --space-color: #f6ca46;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 40%; --y: 56%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        JavaScript path
                        ===================================== -->

                    <div class="board-space inner-space"
                        style="--x: 24%; --y: 35%;
                                --space-color: #25ad63;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 32%; --y: 39.5%;
                                --space-color: #9748dc;">
                        <span class="board-space-marker"></span>
                    </div>

                    <div class="board-space inner-space"
                        style="--x: 40%; --y: 44%;
                                --space-color: #3182e8;">
                        <span class="board-space-marker"></span>
                    </div>


                    <!-- =====================================
                        Center
                        The center represents all six categories.
                        Category-choice logic will be connected later.
                        ===================================== -->

                    <div class="board-center">
                    </div>

                </div>

            </div>

        </section>

        <!-- Sidebar containing information and
             controls for the current game. -->
        <aside class="gameplay-sidebar">

            <!-- Current player and turn controls. -->
            <section class="gameplay-sidebar-card">

                @if (Model.IsGameOver)
                {
                    <h2>Game Over</h2>

                    <p>
                        Winner:
                        <strong>@Model.WinnerName</strong>
                    </p>
                }
                else
                {
                    <h3>Current Player</h3>

                    <h2>
                        @Model.PlayerName
                    </h2>

                    <p>
                        Player @Model.PlayerNumber
                    </p>

                    <!-- Normal turn before the dice is rolled. -->
                    @if (Model.CanRollDice)
                    {
                        <p>
                            @Model.PlayerName can roll the dice.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="RollDice"
                              method="post">

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Roll Dice
                            </button>
                        </form>
                    }

                    <!-- Final category selection. -->
                    @if (Model.NeedsFinalCategory)
                    {
                        <h3>Final Turn</h3>

                        <p>
                            The other players must choose
                            the category for the final question.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="SelectFinalCategory"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="category"
                                        value="Java"
                                        class="btn btn-outline-primary">
                                    Java
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="JavaScript"
                                        class="btn btn-outline-primary">
                                    JavaScript
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="HTML/CSS"
                                        class="btn btn-outline-primary">
                                    HTML/CSS
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Python"
                                        class="btn btn-outline-primary">
                                    Python
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Game History"
                                        class="btn btn-outline-primary">
                                    Game History
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="C#"
                                        class="btn btn-outline-primary">
                                    C#
                                </button>

                            </div>
                        </form>
                    }

                    <!-- Show the current question after a turn starts. -->
                    @if (Model.HasActiveTurn)
                    {
                        @if (!Model.IsFinalTurn)
                        {
                            <p>
                                Dice roll:
                                <strong>@Model.DiceRoll</strong>
                            </p>
                        }

                        <p>
                            Category:
                            <strong>@Model.Category</strong>
                        </p>

                        <h3>
                            @Model.Question.QuestionText
                        </h3>

                        <!-- Sends the selected answer
                             to SubmitAnswer. -->
                        <form asp-controller="Gameplay"
                              asp-action="SubmitAnswer"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.A"
                                        class="btn btn-outline-primary">
                                    A: @Model.Question.AnswerA
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.B"
                                        class="btn btn-outline-primary">
                                    B: @Model.Question.AnswerB
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.C"
                                        class="btn btn-outline-primary">
                                    C: @Model.Question.AnswerC
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.D"
                                        class="btn btn-outline-primary">
                                    D: @Model.Question.AnswerD
                                </button>

                            </div>
                        </form>
                    }
                }

            </section>

            <!-- Shows wedge progress for the current player. -->
            <section class="gameplay-sidebar-card">

                <h3>Collected Wedges</h3>

                @if (Model.Wedges.Count == 0)
                {
                    <p>
                        No wedges collected yet.
                    </p>
                }
                else
                {
                    <ul>
                        @foreach (string wedge in Model.Wedges)
                        {
                            <li>@wedge</li>
                        }
                    </ul>
                }

                <h3>Missing Wedges</h3>

                @if (Model.MissingWedges.Count == 0)
                {
                    <p>
                        All wedges collected!
                    </p>
                }
                else
                {
                    <ul>
                        @foreach (string wedge in Model.MissingWedges)
                        {
                            <li>@wedge</li>
                        }
                    </ul>
                }

            </section>

        </aside>

    </div>
}