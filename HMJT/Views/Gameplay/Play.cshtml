        </section>


        <!-- Sidebar containing information and
             controls for the current game. -->
        <aside class="gameplay-sidebar">

            <!-- Current player and turn controls. -->
            <section class="gameplay-sidebar-card">

                @if (Model.IsGameOver)
                {
                    <h2>Game Over</h2>

                    <p>
                        Winner:
                        <strong>@Model.WinnerName</strong>
                    </p>
                }
                else
                {
                    <h2>Current Player</h2>

                    <h3>
                        @Model.PlayerName
                    </h3>

                    <p>
                        Player @Model.PlayerNumber
                    </p>

                    <!-- Temporarily shows the player's current
                         board position while movement is developed. -->
                    <p>
                        Board position:
                        <strong>@Model.CurrentBoardSpaceId</strong>
                    </p>

                    <!-- Show the current dice roll while the player
                         is choosing a legal movement destination. -->
                    @if (Model.IsWaitingForMove)
                    {
                        <p>
                            Dice roll:
                            <strong>@Model.DiceRoll</strong>
                        </p>

                        <p>
                            Choose one of the highlighted spaces
                            on the board.
                        </p>
                    }

                    <!-- Normal turn before the dice is rolled. -->
                    @if (Model.CanRollDice)
                    {
                        <p>
                            @Model.PlayerName can roll the dice.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="RollDice"
                              method="post">

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Roll Dice
                            </button>

                        </form>
                    }

                    <!-- Normal center category selection.
                        Used when the player reaches the center
                        without having collected all six wedges. -->
                    @if (Model.NeedsCenterCategory)
                    {
                        <h3>Choose Category</h3>

                        <p>
                            You reached the center.
                            Choose the category for your question.
                        </p>

                        <form asp-controller="Gameplay"
                            asp-action="SelectCenterCategory"
                            method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="category"
                                        value="Java"
                                        class="btn btn-outline-primary">
                                    Java
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="JavaScript"
                                        class="btn btn-outline-primary">
                                    JavaScript
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="HTML/CSS"
                                        class="btn btn-outline-primary">
                                    HTML/CSS
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Python"
                                        class="btn btn-outline-primary">
                                    Python
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Game History"
                                        class="btn btn-outline-primary">
                                    Game History
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="C#"
                                        class="btn btn-outline-primary">
                                    C#
                                </button>

                            </div>

                        </form>
                    }

                    <!-- Final category selection.
                         This will later be connected to reaching
                         the center after collecting all six wedges. -->
                    @if (Model.NeedsFinalCategory)
                    {
                        <h3>Final Turn</h3>

                        <p>
                            The other players must choose
                            the category for the final question.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="SelectFinalCategory"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="category"
                                        value="Java"
                                        class="btn btn-outline-primary">
                                    Java
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="JavaScript"
                                        class="btn btn-outline-primary">
                                    JavaScript
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="HTML/CSS"
                                        class="btn btn-outline-primary">
                                    HTML/CSS
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Python"
                                        class="btn btn-outline-primary">
                                    Python
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Game History"
                                        class="btn btn-outline-primary">
                                    Game History
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="C#"
                                        class="btn btn-outline-primary">
                                    C#
                                </button>

                            </div>

                        </form>
