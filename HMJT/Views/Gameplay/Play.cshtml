                                aria-label="Move to the center of the board">
                        </button>

                        <!-- =====================================
                            Player pieces
                            ===================================== -->

                        <!-- Draw each player's physical piece
                            on the board space stored in BoardSpaceId. -->
                        @foreach (PlayerGameState player in Model.Players)
                        {
                            // Find all players currently standing
                            // on the same board space.
                            List<PlayerGameState> playersOnSameSpace =
                                Model.Players
                                    .Where(p => p.BoardSpaceId == player.BoardSpaceId)
                                    .OrderBy(p => p.PlayerNumber)
                                    .ToList();

                            // Find this player's position inside that group.
                            // This is used to slightly separate pieces
                            // when multiple players share the same space.
                            int playerOffsetIndex =
                                playersOnSameSpace.FindIndex(
                                    p => p.PlayerNumber == player.PlayerNumber
                                );

                            <!-- Visual player piece.
                                role="img" makes the descriptive aria-label available
                                to assistive technologies. The same information is also
                                available as text in the player list beside the board. -->
                            <div class="board-player-piece
                                        board-player-offset-@playerOffsetIndex
                                        @(player.PlayerNumber == Model.PlayerNumber
                                            ? "current-board-player"
                                            : "")"
                                style="@GetBoardSpacePosition(player.BoardSpaceId)"
                                role="img"
                                aria-label="@player.PlayerName, player @player.PlayerNumber, board space @player.BoardSpaceId">

                                <!-- Uses the same wedge system as
                                    the sidebar player token. -->
                                <div class="@GetWedgeTokenClass(player.Wedges) board-wedge-token">

                                    <!-- Player number remains visible
                                        even when wedges are collected. -->
                                    <span class="board-player-number">
                                        @player.PlayerNumber
                                    </span>

                                </div>

                            </div>
                        }

                    </div>

                </form>

