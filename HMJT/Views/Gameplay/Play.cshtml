                                class="board-space inner-space @(IsLegalDestination(37) ? "legal-destination" : "")"
                                style="--x: 24%; --y: 65%;
                                       --space-color: #f59a45;"
                                disabled="@(IsLegalDestination(37) ? null : "disabled")"
                                aria-label="Move to HTML CSS space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 38: Python -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="38"
                                class="board-space inner-space @(IsLegalDestination(38) ? "legal-destination" : "")"
                                style="--x: 32%; --y: 60.5%;
                                       --space-color: #f6ca46;"
                                disabled="@(IsLegalDestination(38) ? null : "disabled")"
                                aria-label="Move to Python space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 39: JavaScript -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="39"
                                class="board-space inner-space @(IsLegalDestination(39) ? "legal-destination" : "")"
                                style="--x: 40%; --y: 56%;
                                       --space-color: #25ad63;"
                                disabled="@(IsLegalDestination(39) ? null : "disabled")"
                                aria-label="Move to JavaScript space">
                            <span class="board-space-marker"></span>
                        </button>


                        <!-- =====================================
                             JavaScript path
                             ===================================== -->

                        <!-- Space 40: JavaScript -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="40"
                                class="board-space inner-space @(IsLegalDestination(40) ? "legal-destination" : "")"
                                style="--x: 24%; --y: 35%;
                                       --space-color: #25ad63;"
                                disabled="@(IsLegalDestination(40) ? null : "disabled")"
                                aria-label="Move to JavaScript space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 41: C# -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="41"
                                class="board-space inner-space @(IsLegalDestination(41) ? "legal-destination" : "")"
                                style="--x: 32%; --y: 39.5%;
                                       --space-color: #9748dc;"
                                disabled="@(IsLegalDestination(41) ? null : "disabled")"
                                aria-label="Move to C sharp space">
                            <span class="board-space-marker"></span>
                        </button>

                        <!-- Space 42: Java -->
                        <button type="submit"
                                name="boardSpaceId"
                                value="42"
                                class="board-space inner-space @(IsLegalDestination(42) ? "legal-destination" : "")"
                                style="--x: 40%; --y: 44%;
                                       --space-color: #3182e8;"
                                disabled="@(IsLegalDestination(42) ? null : "disabled")"
                                aria-label="Move to Java space">
                            <span class="board-space-marker"></span>
                        </button>


                        <!-- =====================================
                             Center - space 43
                             The center can be reached from all six
                             inner paths and will later allow category choice.
                             ===================================== -->

                        <button type="submit"
                                name="boardSpaceId"
                                value="43"
                                class="board-center @(IsLegalDestination(43) ? "legal-destination" : "")"
                                disabled="@(IsLegalDestination(43) ? null : "disabled")"
                                aria-label="Move to the center of the board">
                        </button>

                    </div>

                </form>

            </div>

        </section>


        <!-- Sidebar containing information and
             controls for the current game. -->
        <aside class="gameplay-sidebar">

            <!-- Current player and turn controls. -->
            <section class="gameplay-sidebar-card">

                @if (Model.IsGameOver)
                {
                    <h2>Game Over</h2>

                    <p>
                        Winner:
                        <strong>@Model.WinnerName</strong>
                    </p>
                }
                else
                {
                    <h3>Current Player</h3>

                    <h2>
                        @Model.PlayerName
                    </h2>

                    <p>
                        Player @Model.PlayerNumber
                    </p>

                    <!-- Temporarily shows the player's current
                         board position while movement is developed. -->
                    <p>
                        Board position:
                        <strong>@Model.CurrentBoardSpaceId</strong>
                    </p>

                    <!-- Show the current dice roll while the player
                         is choosing a legal movement destination. -->
                    @if (Model.IsWaitingForMove)
                    {
                        <p>
                            Dice roll:
                            <strong>@Model.DiceRoll</strong>
                        </p>

                        <p>
                            Choose one of the highlighted spaces
                            on the board.
                        </p>
                    }

                    <!-- Normal turn before the dice is rolled. -->
                    @if (Model.CanRollDice)
                    {
                        <p>
                            @Model.PlayerName can roll the dice.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="RollDice"
                              method="post">

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Roll Dice
                            </button>

                        </form>
                    }

                    <!-- Normal center category selection.
                        Used when the player reaches the center
                        without having collected all six wedges. -->
                    @if (Model.NeedsCenterCategory)
                    {
                        <h3>Choose Category</h3>

                        <p>
                            You reached the center.
                            Choose the category for your question.
                        </p>

                        <form asp-controller="Gameplay"
                            asp-action="SelectCenterCategory"
                            method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="category"
                                        value="Java"
                                        class="btn btn-outline-primary">
                                    Java
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="JavaScript"
                                        class="btn btn-outline-primary">
                                    JavaScript
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="HTML/CSS"
                                        class="btn btn-outline-primary">
                                    HTML/CSS
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Python"
                                        class="btn btn-outline-primary">
                                    Python
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Game History"
                                        class="btn btn-outline-primary">
                                    Game History
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="C#"
                                        class="btn btn-outline-primary">
                                    C#
                                </button>

                            </div>

                        </form>
                    }

                    <!-- Final category selection.
                         This will later be connected to reaching
                         the center after collecting all six wedges. -->
                    @if (Model.NeedsFinalCategory)
                    {
                        <h3>Final Turn</h3>

                        <p>
                            The other players must choose
                            the category for the final question.
                        </p>

                        <form asp-controller="Gameplay"
                              asp-action="SelectFinalCategory"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="category"
                                        value="Java"
                                        class="btn btn-outline-primary">
                                    Java
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="JavaScript"
                                        class="btn btn-outline-primary">
                                    JavaScript
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="HTML/CSS"
                                        class="btn btn-outline-primary">
                                    HTML/CSS
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Python"
                                        class="btn btn-outline-primary">
                                    Python
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="Game History"
                                        class="btn btn-outline-primary">
                                    Game History
                                </button>

                                <button type="submit"
                                        name="category"
                                        value="C#"
                                        class="btn btn-outline-primary">
                                    C#
                                </button>

                            </div>

                        </form>
                    }

                    <!-- Show the current question after
                         a question turn has started. -->
                    @if (Model.HasActiveTurn)
                    {
                        @if (!Model.IsFinalTurn)
                        {
                            <p>
                                Dice roll:
                                <strong>@Model.DiceRoll</strong>
                            </p>
                        }

                        <p>
                            Category:
                            <strong>@Model.Category</strong>
                        </p>

                        <h3>
                            @Model.Question.QuestionText
                        </h3>

                        <!-- Sends the selected answer
                             to GameplayController.SubmitAnswer. -->
                        <form asp-controller="Gameplay"
                              asp-action="SubmitAnswer"
                              method="post">

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.A"
                                        class="btn btn-outline-primary">
                                    A: @Model.Question.AnswerA
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.B"
                                        class="btn btn-outline-primary">
                                    B: @Model.Question.AnswerB
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.C"
                                        class="btn btn-outline-primary">
                                    C: @Model.Question.AnswerC
                                </button>

                                <button type="submit"
                                        name="selectedAnswer"
                                        value="@AnswerOption.D"
                                        class="btn btn-outline-primary">
                                    D: @Model.Question.AnswerD
                                </button>

                            </div>

                        </form>
                    }
                }

            </section>


            <!-- Shows wedge progress for the current player.
                 A visual six-piece player token will be added later
                 in addition to this text representation. -->
            <section class="gameplay-sidebar-card">

                <h3>Collected Wedges</h3>

                <!-- Shows a visual token that fills up
                    as the player collects wedges. -->
                <div class="wedge-progress-visual">

                    <div class="@GetWedgeTokenClass(Model.Wedges)"
                        aria-label="Visual wedge progress for current player">
                    </div>

                    <div>
                        @if (Model.Wedges.Count == 0)
                        {
                            <p>
                                No wedges collected yet.
                            </p>
                        }
                        else
                        {
                            <ul>
                                @foreach (string wedge in Model.Wedges)
                                {
                                    <li>@wedge</li>
                                }
                            </ul>
                        }
                    </div>

                </div>

                <h3>Missing Wedges</h3>

                @if (Model.MissingWedges.Count == 0)
                {
                    <p>
                        All wedges collected!
                    </p>
                }
                else
                {
                    <ul>
                        @foreach (string wedge in Model.MissingWedges)
                        {
                            <li>@wedge</li>
                        }
                    </ul>
                }

                <h3>Players</h3>

                <div class="player-token-list">

                    @foreach (PlayerGameState player in Model.Players)
                    {
                        <div class="player-token-item @(player.PlayerNumber == Model.PlayerNumber ? "current-player-token" : "")">

                            <div class="@GetWedgeTokenClass(player.Wedges, true)"
                                aria-label="Collected wedges for @player.PlayerName">
                            </div>

                            <div class="player-token-text">
                                <p class="player-token-name">
                                    P@player.PlayerNumber · @player.PlayerName
                                </p>

                                <p class="player-token-space">
                                    Board space: @player.BoardSpaceId
                                </p>

                                <p class="player-token-space">
                                    @player.Wedges.Count / 6 wedges collected
                                </p>
                            </div>

                        </div>
                    }

                </div>

            </section>

        </aside>

    </div>
}